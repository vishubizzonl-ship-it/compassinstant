---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="mesh-gradient relative overflow-hidden" aria-label={t('hero.subtitle')}>
  <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-32 pb-20 lg:pt-44 lg:pb-28 relative">
    <div class="max-w-[48rem] mx-auto text-center">
      <h1 class="font-sans text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-tighter leading-[1.05] text-ink mb-6" set:html={t('hero.title')} />
      <p class="text-lg sm:text-xl text-body leading-relaxed max-w-[36rem] mx-auto mb-10">
        {t('hero.desc')}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="#start" class="inline-flex rounded-full bg-ink text-canvas-elevated text-base font-medium px-7 py-3.5 hover:bg-ink/90 transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none shadow-[0px_1px_2px_rgba(0,0,0,0.06)]">{t('hero.cta.start')}</a>
        <a href="#features" class="inline-flex rounded-full bg-canvas-elevated text-ink text-base font-medium px-7 py-3.5 hover:bg-canvas hover:border-ink/10 border border-hairline transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none shadow-[0px_1px_2px_rgba(0,0,0,0.04)]">{t('hero.cta.explore')}</a>
      </div>
    </div>
  </div>
</section>
