---
---
<section class="mesh-gradient relative overflow-hidden" aria-label="Hero">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-32 pb-20 lg:pt-44 lg:pb-28 relative">
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-mute mb-6">Navigation tools for the modern web</p>
      <h1 class="font-sans text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-tighter leading-[1.05] text-ink mb-6">
        Compass, level, speedometer — and a <span class="text-gradient">qibla finder</span>.
      </h1>
      <p class="text-lg sm:text-xl text-body leading-relaxed max-w-xl mb-10">
        Built with device sensors, designed like a developer platform. Works offline, respects privacy, and looks like Vercel.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="#start" class="inline-flex rounded-full bg-ink text-canvas-elevated text-base font-medium px-7 py-3.5 hover:bg-ink/90 transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none shadow-[0px_1px_2px_rgba(0,0,0,0.06)]">Start Navigating</a>
        <a href="#features" class="inline-flex rounded-full bg-canvas-elevated text-ink text-base font-medium px-7 py-3.5 hover:bg-canvas hover:border-ink/10 border border-hairline transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none shadow-[0px_1px_2px_rgba(0,0,0,0.04)]">Explore Tools</a>
      </div>
    </div>
  </div>
  <!-- Decorative gradient blobs -->
  <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-[600px] h-[600px] rounded-full bg-gradient-to-br from-violet/10 to-transparent blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/4 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-cyan/10 to-transparent blur-3xl pointer-events-none" aria-hidden="true"></div>
</section>
