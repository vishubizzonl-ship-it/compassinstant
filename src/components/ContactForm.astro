---
/**
 * Contact form — shared by every silo so all five contact pages behave the same.
 *
 * `action="mailto:"` alone is silently ignored by Chrome on desktop, so the
 * submit is handled here: the visitor's input is packed into a mailto: link
 * that opens their mail app with everything filled in, and the page tells them
 * to press Send. Nothing is transmitted by the site itself.
 */
const EMAIL = 'hello@instanten.com';
---
<form
  id="contact-form"
  class="space-y-4"
  data-email={EMAIL}
  novalidate={false}>
  <div>
    <label for="name" class="block text-sm font-medium text-ink mb-1">Name</label>
    <input id="name" name="name" type="text" required autocomplete="name" class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none" />
  </div>
  <div>
    <label for="email" class="block text-sm font-medium text-ink mb-1">Email</label>
    <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none" />
  </div>
  <div>
    <label for="subject" class="block text-sm font-medium text-ink mb-1">Subject</label>
    <select id="subject" name="subject" class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none">
      <option>Bug report</option>
      <option>Feature request</option>
      <option>Calibration / accuracy issue</option>
      <option>Privacy question</option>
      <option>Other</option>
    </select>
  </div>
  <div>
    <label for="message" class="block text-sm font-medium text-ink mb-1">Message</label>
    <textarea id="message" name="message" rows="5" required class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none"></textarea>
  </div>
  <button type="submit" class="inline-flex items-center rounded-full bg-ink text-canvas px-5 py-2 text-sm font-medium hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none">
    Send message
  </button>
  <p id="contact-form-status" role="status" aria-live="polite" class="text-sm text-body leading-relaxed"></p>
</form>

<script>
  (function () {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;
    const status = document.getElementById('contact-form-status');
    const email = form.dataset.email || 'hello@instanten.com';

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const from = String(data.get('email') || '').trim();
      const subject = String(data.get('subject') || 'Website message');
      const message = String(data.get('message') || '').trim();

      if (!name || !from || !message) {
        if (status) status.textContent = 'Please fill in your name, email and message.';
        return;
      }

      const body = `Name: ${name}\nEmail: ${from}\nSubject: ${subject}\n\n${message}`;
      const href =
        `mailto:${email}?subject=` +
        encodeURIComponent(`[${subject}] ${name}`) +
        '&body=' +
        encodeURIComponent(body);

      window.location.href = href;

      if (status) {
        status.textContent =
          `Your email app is opening with this message ready to send. Press Send there — ` +
          `nothing is sent until you do. If nothing opened, email ${email} directly.`;
      }
    });
  })();
</script>
