---
/**
 * Renders the numbered sections of the Privacy and Terms pages from
 * src/i18n/supportCopy.ts, keeping the original heading, paragraph and bullet
 * markup and classes exactly as they were.
 */
import CopyText from './CopyText.astro';
import type { Section } from '../i18n/supportCopy';

interface Props {
  sections: Section[];
  contactHref: string;
  contactLabel: string;
  contactCta: string;
}

const { sections, contactHref, contactLabel, contactCta } = Astro.props;

type Block = { type: 'p'; text: string } | { type: 'ul'; items: string[] };

const plan: { h: string; blocks: Block[]; first: boolean }[] = sections.map((section, sectionIndex) => {
  const listAfter = section.listAt ?? section.paras.length - 1;
  const blocks: Block[] = [];
  section.paras.forEach((text, i) => {
    blocks.push({ type: 'p', text });
    if (section.list && i === listAfter) blocks.push({ type: 'ul', items: section.list });
  });
  return { h: section.h, blocks, first: sectionIndex === 0 };
});
---

{plan.map(({ h, blocks, first }) => (
  <>
    <h2 class={`font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink ${first ? 'mt-8' : 'mt-10'} mb-4`}>{h}</h2>
    {blocks.map((block) =>
      block.type === 'ul' ? (
        <ul class="list-disc pl-6 space-y-2 text-body text-base leading-relaxed mb-4">
          {block.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ) : (
        <CopyText
          text={block.text}
          contactHref={contactHref}
          contactLabel={contactLabel}
          contactCta={contactCta}
        />
      )
    )}
  </>
))}
