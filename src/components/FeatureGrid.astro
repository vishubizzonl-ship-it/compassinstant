---
---
<section id="features" class="py-24 lg:py-32" aria-label="Features">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex items-end justify-between mb-12 lg:mb-16">
      <div>
        <p class="font-mono text-xs font-medium uppercase tracking-wider text-mute mb-3">Features</p>
        <h2 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink">Four tools. One toolkit.</h2>
      </div>
      <a href="#start" class="hidden sm:inline-flex rounded-full bg-ink text-canvas-elevated text-sm font-medium px-5 py-2.5 hover:bg-ink/90 transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none">Get started</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Compass -->
      <article class="group bg-canvas-elevated border border-hairline rounded-md p-6 lg:p-8 hover:border-ink/10 transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
        <div class="mb-6">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-md bg-ink text-canvas-elevated font-mono text-lg font-medium">N</span>
        </div>
        <h3 class="font-sans text-xl font-semibold tracking-tight text-ink mb-3">Online Compass</h3>
        <p class="text-sm text-body leading-relaxed mb-5">
          Real-time magnetometer direction, calibration tool, offline-capable, and location-aware with map integration.
        </p>
        <a href="/" class="inline-flex items-center gap-1.5 text-sm font-medium text-link hover:text-link-deep transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">
          Use Compass
          <span aria-hidden="true" class="text-base leading-none">→</span>
        </a>
      </article>

      <!-- Bubble Level -->
      <article class="group bg-canvas-elevated border border-hairline rounded-md p-6 lg:p-8 hover:border-ink/10 transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
        <div class="mb-6">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-md bg-ink text-canvas-elevated font-mono text-lg font-medium">L</span>
        </div>
        <h3 class="font-sans text-xl font-semibold tracking-tight text-ink mb-3">Bubble Level</h3>
        <p class="text-sm text-body leading-relaxed mb-5">
          Horizontal, vertical, and bull's-eye levels with accelerometer calibration and figure-8 reset guidance.
        </p>
        <a href="/bubble-level/" class="inline-flex items-center gap-1.5 text-sm font-medium text-link hover:text-link-deep transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">
          Use Level
          <span aria-hidden="true" class="text-base leading-none">→</span>
        </a>
      </article>

      <!-- Speedometer -->
      <article class="group bg-canvas-elevated border border-hairline rounded-md p-6 lg:p-8 hover:border-ink/10 transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
        <div class="mb-6">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-md bg-ink text-canvas-elevated font-mono text-lg font-medium">S</span>
        </div>
        <h3 class="font-sans text-xl font-semibold tracking-tight text-ink mb-3">Speedometer</h3>
        <p class="text-sm text-body leading-relaxed mb-5">
          GPS-based speed tracking with max/avg speed, altitude profile, trip duration, and accuracy metrics.
        </p>
        <a href="/speedometer/" class="inline-flex items-center gap-1.5 text-sm font-medium text-link hover:text-link-deep transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">
          Use Speedometer
          <span aria-hidden="true" class="text-base leading-none">→</span>
        </a>
      </article>

      <!-- Qibla -->
      <article class="group bg-canvas-elevated border border-hairline rounded-md p-6 lg:p-8 hover:border-ink/10 transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
        <div class="mb-6">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-md bg-ink text-canvas-elevated font-mono text-lg font-medium">Q</span>
        </div>
        <h3 class="font-sans text-xl font-semibold tracking-tight text-ink mb-3">Qibla Finder</h3>
        <p class="text-sm text-body leading-relaxed mb-5">
          Prayer direction from any location, with vibration feedback and daily prayer time integration.
        </p>
        <a href="/qibla-finder/" class="inline-flex items-center gap-1.5 text-sm font-medium text-link hover:text-link-deep transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">
          Use Qibla
          <span aria-hidden="true" class="text-base leading-none">→</span>
        </a>
      </article>
    </div>
  </div>
</section>
