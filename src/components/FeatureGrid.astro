---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const features = [
  {
    letter: 'N',
    name: 'compass',
    href: '/onlinecompass/',
  },
  {
    letter: 'L',
    name: 'bubble',
    href: '/onlinebubblelevel/',
  },
  {
    letter: 'S',
    name: 'speed',
    href: '/onlinespeedometer/',
  },
  {
    letter: 'Q',
    name: 'qibla',
    href: '/onlineqibla/',
  },
] as const;
---
<section id="features" class="py-24 lg:py-32" aria-label={t('features.subtitle')}>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex items-end justify-between mb-12 lg:mb-16">
      <div>
        <p class="font-mono text-xs font-medium uppercase tracking-wider text-mute mb-3">{t('features.subtitle')}</p>
        <h2 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink">{t('features.title')}</h2>
      </div>
      <a href="#start" class="hidden sm:inline-flex rounded-full bg-ink text-canvas-elevated text-sm font-medium px-5 py-2.5 hover:bg-ink/90 transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none">{t('features.getstarted')}</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <article class="group bg-canvas-elevated border border-hairline rounded-md p-6 lg:p-8 hover:border-ink/10 transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
          <div class="mb-6">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-md bg-ink text-canvas-elevated font-mono text-lg font-medium">{feature.letter}</span>
          </div>
          <h3 class="font-sans text-xl font-semibold tracking-tight text-ink mb-3">{t(`feature.${feature.name}.title`)}</h3>
          <p class="text-sm text-body leading-relaxed mb-5">
            {t(`feature.${feature.name}.desc`)}
          </p>
          <a href={translatePath(feature.href)} class="inline-flex items-center gap-1.5 text-sm font-medium text-link hover:text-link-deep transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">
            {t(`feature.${feature.name}.cta`)}
            <span aria-hidden="true" class="text-base leading-none">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
