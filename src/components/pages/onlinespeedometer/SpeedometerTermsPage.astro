---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import LegalSections from '../../LegalSections.astro';
import CopyText from '../../CopyText.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { supportCopy } from '../../../i18n/supportCopy';
import { speedometerSupport } from '../../../i18n/speedometerSupport';
import { speedometerLegal } from '../../../i18n/speedometerLegal';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = supportCopy[lang] ?? supportCopy.en;
const seo = speedometerSupport[lang] ?? speedometerSupport.en;
const legal = speedometerLegal[lang] ?? speedometerLegal.en;

/**
 * The shared terms, adjusted for a speedometer: the intro and "1. Use of the
 * Service" name this tool, and the GPS caveats sit inside "2. Accuracy
 * Disclaimer" straight after the bullet list, exactly where the English page
 * always had them.
 */
const sections = copy.terms.sections.map((section, index) => {
  if (index === 0) {
    return { ...section, paras: [legal.termsUse, ...section.paras.slice(1)] };
  }
  if (index === 1) {
    return {
      ...section,
      paras: [section.paras[0], ...legal.termsAccuracy, ...section.paras.slice(1)],
    };
  }
  return section;
});

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://instanten.com/' },
    { '@type': 'ListItem', position: 2, name: t('page.speed.title'), item: 'https://instanten.com/onlinespeedometer/' },
    { '@type': 'ListItem', position: 3, name: t('page.terms.title'), item: 'https://instanten.com/onlinespeedometer/terms/' },
  ],
};
---
<Layout
  title={`${t('page.terms.title')} — ${t('page.speed.title')}`}
  description={seo.aboutDesc}
  keywords={seo.keywords}
  ogImage="/og-image.png"
  ogImageAlt={t('page.terms.title')}
  breadcrumbLd={breadcrumbLd}>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlinespeedometer/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {seo.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.terms.title')}</h1>
    <p class="text-xs text-mute font-mono mb-8">{copy.updated}</p>
    <CopyText
      text={legal.termsIntro}
      class="text-body text-base leading-relaxed mb-6"
      contactHref={translatePath('/onlinespeedometer/contact/')}
      contactLabel={copy.contactLink}
      contactCta={copy.about.contactCta}
      toolLabel={copy.toolPhrase.speed}
    />

    <LegalSections
      sections={sections}
      contactHref={translatePath('/onlinespeedometer/contact/')}
      contactLabel={copy.contactLink}
      contactCta={copy.about.contactCta}
      toolLabel={copy.toolPhrase.speed}
    />
  </main>
  <Footer />
</Layout>
