---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import BubbleLevelFaq from './BubbleLevelFaq.astro';
import CopyText from '../../CopyText.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { bubbleProse } from '../../../i18n/bubbleProse';
import { bubbleSupport } from '../../../i18n/bubbleSupport';
import { supportCopy } from '../../../i18n/supportCopy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = bubbleSupport[lang] ?? bubbleSupport.en;
const shared = supportCopy[lang] ?? supportCopy.en;
const page = bubbleProse[lang] ?? bubbleProse.en;
const about = copy.about;

const copyLinks = {
  contactHref: translatePath('/onlinebubblelevel/contact/'),
  contactLabel: shared.contactLink,
  contactCta: shared.about.contactCta,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://instanten.com/' },
    { '@type': 'ListItem', position: 2, name: 'Online Bubble Level', item: 'https://instanten.com/onlinebubblelevel/' },
    { '@type': 'ListItem', position: 3, name: 'About', item: 'https://instanten.com/onlinebubblelevel/about/' },
  ],
};
---
<Layout
  title={copy.aboutTitle}
  description={copy.aboutDesc}
  keywords={copy.keywords}
  ogImage="/og-bubble-level.png"
  ogImageAlt={copy.aboutTitle}
  breadcrumbLd={breadcrumbLd}>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlinebubblelevel/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {copy.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.about.title')}</h1>
    <p class="text-xs text-mute font-mono mb-8">{shared.updated}</p>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-8 mb-4">{about.whatH}</h2>
    {about.what.map((paragraph) => (
      <CopyText
        text={paragraph}
        contactHref={copyLinks.contactHref}
        contactLabel={copyLinks.contactLabel}
        contactCta={copyLinks.contactCta}
        guideHref="/onlinebubblelevel/blog/how-accurate-is-a-phone-bubble-level/"
        guideLabel={copy.guideLabel}
      />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.howH}</h2>
    {about.how.map((paragraph) => (
      <CopyText
        text={paragraph}
        contactHref={copyLinks.contactHref}
        contactLabel={copyLinks.contactLabel}
        contactCta={copyLinks.contactCta}
        guideHref="/onlinebubblelevel/blog/how-accurate-is-a-phone-bubble-level/"
        guideLabel={copy.guideLabel}
      />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.missionH}</h2>
    {about.mission.map((paragraph) => (
      <CopyText
        text={paragraph}
        contactHref={copyLinks.contactHref}
        contactLabel={copyLinks.contactLabel}
        contactCta={copyLinks.contactCta}
        guideHref="/onlinebubblelevel/blog/how-accurate-is-a-phone-bubble-level/"
        guideLabel={copy.guideLabel}
      />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.featuresH}</h2>
    <ul class="list-disc pl-6 space-y-2 text-body text-base leading-relaxed mb-4">
      {about.features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.whoH}</h2>
    {about.who.map((paragraph) => (
      <CopyText
        text={paragraph}
        contactHref={copyLinks.contactHref}
        contactLabel={copyLinks.contactLabel}
        contactCta={copyLinks.contactCta}
        guideHref="/onlinebubblelevel/blog/how-accurate-is-a-phone-bubble-level/"
        guideLabel={copy.guideLabel}
      />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.accuracyH}</h2>
    {about.accuracy.map((paragraph) => (
      <CopyText
        text={paragraph}
        contactHref={copyLinks.contactHref}
        contactLabel={copyLinks.contactLabel}
        contactCta={copyLinks.contactCta}
        guideHref="/onlinebubblelevel/blog/how-accurate-is-a-phone-bubble-level/"
        guideLabel={copy.guideLabel}
      />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{shared.about.privacyH}</h2>
    <p class="text-body text-base leading-relaxed mb-4">
      {shared.about.privacy} {shared.about.privacyPre}<a href={translatePath('/onlinebubblelevel/privacy/')} class="text-link hover:underline">{shared.about.privacyLink}</a>{shared.about.privacyPost}
    </p>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{shared.about.contactH}</h2>
    <p class="text-body text-base leading-relaxed">
      {shared.about.contact} <a href={translatePath('/onlinebubblelevel/contact/')} class="text-link hover:underline">{shared.about.contactCta}</a>
    </p>
  <BubbleLevelFaq heading={page.faqH} questions={page.faq} />
  </main>
  <Footer />
</Layout>
