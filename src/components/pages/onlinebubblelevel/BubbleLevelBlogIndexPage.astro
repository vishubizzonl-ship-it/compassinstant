---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import BubbleLevelFaq from './BubbleLevelFaq.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { bubbleProse } from '../../../i18n/bubbleProse';
import { bubbleSupport } from '../../../i18n/bubbleSupport';
import { supportCopy } from '../../../i18n/supportCopy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = bubbleSupport[lang] ?? bubbleSupport.en;
const page = bubbleProse[lang] ?? bubbleProse.en;
const shared = supportCopy[lang] ?? supportCopy.en;

const posts = copy.posts;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://instanten.com/' },
    { '@type': 'ListItem', position: 2, name: 'Online Bubble Level', item: 'https://instanten.com/onlinebubblelevel/' },
    { '@type': 'ListItem', position: 3, name: 'Blog', item: 'https://instanten.com/onlinebubblelevel/blog/' },
  ],
};
---
<Layout
  title={copy.blogTitle}
  description={copy.blogDesc}
  keywords={copy.keywords}
  ogImage="/og-bubble-level.png"
  ogImageAlt={copy.blogTitle}
  breadcrumbLd={breadcrumbLd}>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlinebubblelevel/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {copy.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.blog.title')}</h1>
    <p class="text-xs text-mute font-mono mb-4">{shared.updated}</p>
    <p class="text-body text-base leading-relaxed mb-4">
      {copy.blogIntro}
    </p>
    <p class="text-body text-base leading-relaxed mb-10">
      {copy.blogIntro2}
    </p>

    <ul class="space-y-8">
      {posts.map((post) => (
        <li class="border-b border-hairline pb-6">
          <p class="text-xs text-mute font-mono mb-2">{post.date}</p>
          <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mb-2">
            <a href={post.href} class="hover:text-link transition-colors">{post.title}</a>
          </h2>
          <p class="text-body text-base leading-relaxed">{post.desc}</p>
        </li>
      ))}
    </ul>
  <BubbleLevelFaq heading={page.faqH} questions={page.faq} />
  </main>
  <Footer />
</Layout>
