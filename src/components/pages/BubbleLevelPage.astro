---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import ToolBlog from '../ToolBlog.astro';
import BubbleLevelFaq from './onlinebubblelevel/BubbleLevelFaq.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getToolBlog } from '../../i18n/blogs';

const toolBlogFaq = getToolBlog('onlinebubblelevel', 'en')?.faq ?? [];

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const siteUrl = 'https://onlinecompass.example';
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}${baseUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Bubble Level', item: `${siteUrl}${baseUrl}/onlinebubblelevel/` },
  ],
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Online Bubble Level',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  url: `${siteUrl}${baseUrl}/onlinebubblelevel/`,
  description:
    'Free online bubble level: a level checker tool and spirit level online that turns your phone into a leveler tool to check any surface in your browser. No install, no sign-up.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Bubble level check online in degrees',
    'Horizontal, vertical and bullseye vials',
    'Spirit level online on mobile and desktop browsers',
    'No install and no account',
  ],
};
---

<Layout
  title={lang === 'en' ? 'Online Bubble Level — Free Spirit Level & Level Checker' : undefined}
  keywords={lang === 'en' ? 'online bubble level, bubble level, free bubble level, bubble level google, bubble level ruler, bubble level online, spirit level online, vertical level tool online, level checker tool online, leveler tool, bubble level check online, water level tool online, online level bubble level, free online level, online level check google, online bubble level free, bubble level check' : undefined}
  breadcrumbLd={breadcrumbLd}
  appLd={appLd}
  ogImage="/og-bubble-level.png"
  ogImageAlt={lang === 'en' ? 'Online bubble level — free spirit level and level checker tool to check any surface in your browser' : undefined}
>

  <Nav />
  <main>
    <section class="py-4 lg:py-8 pt-2 lg:pt-4" aria-label={t('page.bubble.title')}>
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div id="bubble-card" class="bg-canvas-elevated border border-hairline rounded-md p-6 lg:p-8 shadow-[0px_1px_2px_rgba(0,0,0,0.03)] relative">
          <button type="button" id="bubble-fullscreen-btn" aria-label="Fullscreen" class="absolute top-3 right-3 z-30 inline-flex items-center justify-center w-8 h-8 rounded-sm bg-canvas border border-hairline text-ink hover:bg-canvas-elevated transition-colors">
            <svg class="icon-enter" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <svg class="icon-exit hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
          </button>
          <div class="text-center mb-1">
            <h2 class="font-sans text-xl font-semibold tracking-tight text-ink">{t('bubble.ui.bullseye')}</h2>
            <p id="bubble-status" class="text-xs text-mute font-mono mt-1" role="status" aria-live="polite">{t('bubble.ui.calibrated')}</p>
          </div>

          <div class="flex flex-col items-center gap-2 py-6">
            <div class="flex items-center gap-6 text-xs font-mono tabular-nums text-ink" aria-live="polite">
              <span>X: <span id="bubble-x" class="font-semibold">0.0°</span></span>
              <span>Y: <span id="bubble-y" class="font-semibold">0.0°</span></span>
            </div>
            <div
              id="bubble-area"
              class="relative w-full max-w-[300px] aspect-square bg-canvas-elevated border border-hairline shadow-[inset_0_3px_10px_rgba(0,0,0,0.12),0_1px_2px_rgba(0,0,0,0.04)] overflow-hidden bubble-area"
              aria-label="Spirit level"
            >
              <div class="absolute left-1/2 top-0 bottom-0 w-[2px] crosshair -translate-x-1/2"></div>
              <div class="absolute top-1/2 left-0 right-0 h-[2px] crosshair -translate-y-1/2"></div>
              <div class="absolute bottom-0 left-0 right-0 h-[1px] edge-line"></div>
              <div class="absolute top-0 bottom-0 right-0 w-[1px] edge-line"></div>
              <div
                id="bubble-dot"
                class="absolute top-1/2 left-1/2 w-3 h-3 rounded-full bg-ink shadow-md pointer-events-none z-20"
                style="transform: translate(-50%, -50%);"
              ></div>
            </div>
          </div>

          <p id="bubble-message" class="text-xs text-body font-mono mt-3 text-center" role="alert" aria-live="assertive"></p>
        </div>
      </div>
    </section>
  <style>
    .bubble-area {
      background-image: linear-gradient(to right, rgba(0, 0, 0, 0.9) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.9) 1px, transparent 1px);
      background-size: 10% 10%;
    }
    html.dark .bubble-area {
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.9) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.9) 1px, transparent 1px);
      background-size: 10% 10%;
    }
    .crosshair {
      background-color: rgba(0, 0, 0, 0.9);
    }
    html.dark .crosshair {
      background-color: rgba(255, 255, 255, 0.9);
    }
    .edge-line {
      background-color: rgba(0, 0, 0, 0.9);
    }
    html.dark .edge-line {
      background-color: rgba(255, 255, 255, 0.9);
    }
  </style>
    <section class="py-16 lg:py-24" aria-label={t('compass.how.title')}>
      <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
        <h2 class="font-sans text-2xl font-semibold tracking-tight text-ink mb-8">{t('compass.how.title')}</h2>
        <div class="space-y-8">
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.bubble.how.enable')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.bubble.how.enable.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.bubble.how.calibrate')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.bubble.how.calibrate.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.bubble.how.offline')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.bubble.how.offline.desc')}</p>
          </article>
        </div>
      </div>
    </section>
    <section class="py-16 lg:py-24 border-t border-hairline" aria-labelledby="about-online-bubble-level">
      <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
        <h2 id="about-online-bubble-level" class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-0 mb-4">
          The free online bubble level that checks any surface
        </h2>
        <p class="text-body text-base leading-relaxed mb-4">
          This <strong>online bubble level</strong> turns the phone in your hand into a working
          <strong>level checker tool</strong> in one tap. There is nothing to install, no account to
          create and no download waiting time — you open the page, place the device on the surface and
          the bubble tells you instantly whether that surface is flat, tilted or plumb. It is a
          <strong>free bubble level</strong> built for one job: telling you the truth about a surface
          before you hang a shelf, fix a frame or level a table.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          If you have ever searched for “<em>bubble level online</em>”, “<em>spirit level online</em>”
          or “<em>level checker tool online</em>”, you already know the problem. You are holding a
          picture frame that looks straight, a washing machine that wobbles, or a desk that seems to
          slope — and your eyes are not a measuring instrument. A <strong>bubble level check online</strong>
          removes the guesswork in two seconds, with a number in degrees instead of a hunch.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          What this bubble level tool actually shows you
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          The <strong>online bubble level</strong> reads the accelerometer inside your device and draws
          the same information a physical spirit level shows, only with more detail. You get a
          horizontal vial for flat surfaces, a <strong>vertical level tool online</strong> for plumb
          walls and door frames, and a bullseye view that shows tilt in every direction at once — left
          to right and front to back. Instead of judging where a bubble sits between two lines, you
          read a degrees figure, so “almost level” becomes an exact number you can act on.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          Because the reading is digital, this <strong>leveler tool</strong> can do things a wooden
          level cannot. It updates as you tilt the surface, so you can watch the number fall toward
          zero while you slide a shim under a leg. It keeps working in dark corners where you cannot
          see a bubble clearly. And it never loses its calibration fluid, because there is no fluid —
          the sensor is solid state and the zero point is set in software.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          How to check a surface with the online bubble level
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          Open the page, allow the sensor prompt once, then place the device flat on the surface you
          want to test. Hold it still for a second so the reading settles. The degrees value is your
          answer: a number near 0.0° means the surface is level, and the direction of the offset tells
          you which side needs lifting. For a plumb check, stand the device against the wall on its
          long edge and use the vertical vial in the same way.
        </p>
        <ul class="list-disc pl-6 mb-4 space-y-2 text-body text-base leading-relaxed">
          <li>Take the phone out of its magnetic case and away from metal tools, screws and pipes.</li>
          <li>Check the same surface in two directions, at 90° to each other, before you drill.</li>
          <li>If the reading drifts, put the device on a known flat surface and recalibrate there.</li>
          <li>Keep the device on the surface itself — holding it in your hand adds your own tilt.</li>
        </ul>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          Bubble level vs a physical spirit level
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          A traditional <strong>bubble level ruler</strong> is a sealed tube with a bubble in it, and it
          is excellent at what it does — but you only get it when you remember to carry it. A
          <strong>bubble level online</strong> is already in your pocket, which matters when a shelf
          looks off and you are standing on a chair. The trade-off is precision: a good 60 cm spirit
          level can detect a slope a phone sensor will round away. For hanging, furniture, appliances
          and quick checks the digital reading is more than enough; for tiling a floor or fitting a
          worktop, a long physical level still wins.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          Many people search for a <strong>water level tool online</strong> expecting a hose-and-water
          levelling trick. This page does the same job electronically: no water, no hose, no mess, and
          it works at any distance from the surface. Likewise, if a <strong>bubble level Google</strong>
          search brought you here, the tool below is the interactive answer — not a diagram of one.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          Who uses a free online level
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          Anyone who hangs, builds, mounts or installs. Homeowners use the <strong>free online level</strong>
          to hang picture frames, shelves and mirrors straight the first time. Renters use the
          <strong>online level bubble level</strong> to check whether a wardrobe or a fridge is sitting
          level before blaming the door. DIY and carpentry work uses the vertical vial for door frames,
          studs and posts. Photographers and videographers check that a tripod head is flat.
          <strong>Online level check google</strong> searches also spike around furniture assembly —
          flat-pack instructions assume a level floor, and a phone is the only tool within reach.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          Beyond the workshop, the same <strong>online bubble level free</strong> reading helps in
          small everyday ways. Check whether a table rocks because the floor slopes or because one leg
          is short. Confirm a washing machine is level so it stops walking across the floor. Level a
          camper van, a caravan or a rooftop tent before you sleep in it. Set up a pool table, a
          ping-pong table or a dartboard. Test a new phone case or a desk stand for wobble. None of
          these jobs need a toolbox — they need one honest number.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          Accuracy, privacy and what to expect
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          Accuracy depends on the sensor in your device, not on the page. Phone accelerometers are
          typically good to about one degree, which is plenty for hanging and furniture work, and the
          reading gets more stable the longer the device sits still. Nothing is uploaded: the sensor
          data is read in your browser and never leaves the device, no account is needed and there is
          no tracking of your readings. Once the page has loaded, this
          <strong>bubble level check</strong> keeps working even without a network connection, which is
          useful in a basement, a garage or a building site.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          Use it as a fast <strong>level checker tool</strong> before you commit to a hole in the wall,
          and keep a physical level for the jobs where millimetres matter. That combination — a phone
          for the quick answer, a spirit level for the final fix — is how most people actually work.
          If the bubble looks wrong, check the surface, the calibration and nearby metal before you
          blame the tool, and recalibrate on a surface you trust.
        </p>
      </div>
    </section>

  <ToolBlog tool="onlinebubblelevel" faqLd={false} />

  <section class="py-16 lg:py-24 border-t border-hairline" aria-labelledby="bubble-guides-title">
    <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
      <h2 id="bubble-guides-title" class="font-sans text-2xl sm:text-3xl font-semibold tracking-tight text-ink mb-6">
        Latest guides from the Bubble Level blog
      </h2>
      <ul class="flex flex-col gap-0 border border-hairline rounded-md overflow-hidden">
        <li class="border-b border-hairline last:border-b-0">
          <a href="/onlinebubblelevel/blog/how-to-use-an-online-bubble-level" class="block px-4 py-4 hover:bg-canvas transition-colors">
            <span class="block font-sans text-base font-medium text-ink">How to Use an Online Bubble Level (Step-by-Step)</span>
            <span class="block text-sm text-body mt-1">Open the page, place the phone flat, calibrate, and read the tilt in degrees.</span>
          </a>
        </li>
        <li class="border-b border-hairline last:border-b-0">
          <a href="/onlinebubblelevel/blog/how-accurate-is-a-phone-bubble-level" class="block px-4 py-4 hover:bg-canvas transition-colors">
            <span class="block font-sans text-base font-medium text-ink">How Accurate Is a Phone Bubble Level?</span>
            <span class="block text-sm text-body mt-1">Typical error, what ruins a reading, and how to calibrate for a reliable check.</span>
          </a>
        </li>
        <li class="border-b border-hairline last:border-b-0">
          <a href="/onlinebubblelevel/blog/level-furniture-shelves-appliances" class="block px-4 py-4 hover:bg-canvas transition-colors">
            <span class="block font-sans text-base font-medium text-ink">How to Level Furniture, Shelves and Appliances</span>
            <span class="block text-sm text-body mt-1">Step-by-step checks for a rocking table, a leaning bookcase and a walking washing machine.</span>
          </a>
        </li>
        <li class="border-b border-hairline last:border-b-0">
          <a href="/onlinebubblelevel/blog/bubble-level-vs-spirit-level" class="block px-4 py-4 hover:bg-canvas transition-colors">
            <span class="block font-sans text-base font-medium text-ink">Bubble Level vs Spirit Level</span>
            <span class="block text-sm text-body mt-1">Accuracy, cost and speed compared, and when to reach for a real level.</span>
          </a>
        </li>
      </ul>
      <p class="text-body text-base leading-relaxed mt-6">
        <a href="/onlinebubblelevel/blog/" class="text-link hover:underline">See all Online Bubble Level guides →</a>
      </p>
    </div>
  </section>
  <BubbleLevelFaq extraQuestions={toolBlogFaq} heading="Frequently asked questions about the online bubble level" />
  </main>
  <Footer />
</Layout>

<script>
  (function () {
    const area = document.getElementById('bubble-area');
    const card = document.getElementById('bubble-card');
    const fsBtn = document.getElementById('bubble-fullscreen-btn');
    function syncFsIcon() {
      if (!fsBtn) return;
      const entering = !document.fullscreenElement;
      fsBtn.querySelector('.icon-enter')?.classList.toggle('hidden', !entering);
      fsBtn.querySelector('.icon-exit')?.classList.toggle('hidden', entering);
    }
    if (fsBtn) {
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else if (card && card.requestFullscreen) card.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', syncFsIcon);
      syncFsIcon();
    }
    const dot = document.getElementById('bubble-dot');
    const xEl = document.getElementById('bubble-x');
    const yEl = document.getElementById('bubble-y');
    const statusEl = document.getElementById('bubble-status');
    const messageEl = document.getElementById('bubble-message');

    const SCALE = 3; // px per degree
    const LEVEL_TOL = 3; // degrees

    function getScreenAngle() {
      try {
        if (window.screen && window.screen.orientation && typeof window.screen.orientation.angle === 'number') {
          return window.screen.orientation.angle;
        }
      } catch (e) {}
      if (typeof window.orientation === 'number') {
        return (window.orientation + 360) % 360;
      }
      return 0;
    }
    let running = false;
    let smoothX = 0;
    let smoothY = 0;
    let targetX = 0;
    let targetY = 0;
    let rafId: number | null = null;

    function setMessage(msg: string) {
      if (messageEl) messageEl.textContent = msg;
    }

    function setStatus(msg: string) {
      if (statusEl) statusEl.textContent = msg;
    }

    function getMaxTravel() {
      if (!area || !dot) return 100;
      const rect = area.getBoundingClientRect();
      const dotSize = dot.getBoundingClientRect().width || 24;
      return Math.min(rect.width, rect.height) / 2 - dotSize / 2 - 4;
    }

    function clampToSquare(x: number, y: number) {
      const maxTravel = getMaxTravel();
      return {
        x: Math.max(-maxTravel, Math.min(maxTravel, x)),
        y: Math.max(-maxTravel, Math.min(maxTravel, y)),
      };
    }

    function updateDot() {
      smoothX += (targetX - smoothX) * 0.15;
      smoothY += (targetY - smoothY) * 0.15;
      if (dot) {
        dot.style.transform = `translate(calc(-50% + ${smoothX.toFixed(1)}px), calc(-50% + ${smoothY.toFixed(1)}px))`;
      }
      rafId = requestAnimationFrame(updateDot);
    }

    function handleOrientation(event: DeviceOrientationEvent) {
      if (!running) return;
      const beta = typeof event.beta === 'number' ? event.beta : 0;
      const gamma = typeof event.gamma === 'number' ? event.gamma : 0;

      const tiltX = Math.max(-60, Math.min(60, gamma));
      const tiltY = Math.max(-60, Math.min(60, beta));

      const rawX = tiltX * SCALE;
      const rawY = tiltY * SCALE;
      const clamped = clampToSquare(rawX, rawY);
      targetX = clamped.x;
      targetY = clamped.y;

      if (xEl) xEl.textContent = tiltX.toFixed(1) + '°';
      if (yEl) yEl.textContent = tiltY.toFixed(1) + '°';

      if (Math.abs(tiltX) <= LEVEL_TOL && Math.abs(tiltY) <= LEVEL_TOL) {
        setStatus('Level');
      } else if (running) {
        setStatus('Tilt to level');
      }
    }

    async function start() {
      if (running) return;
      if (!window.isSecureContext) {
        setMessage('Sensor access requires HTTPS or localhost.');
        return;
      }
      if (!window.DeviceOrientationEvent) {
        setMessage('Device orientation sensor is not supported on this device.');
        return;
      }
      if (typeof (DeviceOrientationEvent as any).requestPermission === 'function') {
        try {
          const res = await (DeviceOrientationEvent as any).requestPermission();
          if (res !== 'granted') {
            setMessage('Permission denied. Enable motion sensors in browser settings.');
            return;
          }
        } catch {
          setMessage('Permission request failed. Tap again to retry.');
          return;
        }
      }
      running = true;
      setStatus('Tilt to level');
      setMessage('');
      window.addEventListener('deviceorientation', handleOrientation);
      if (rafId === null) rafId = requestAnimationFrame(updateDot);
    }

    function stop() {
      running = false;
      window.removeEventListener('deviceorientation', handleOrientation);
      targetX = 0;
      targetY = 0;
      setStatus('Stopped');
    }

    // auto-start; allow tap to retry if permission failed
    start();
    if (area) area.addEventListener('click', () => { if (!running) start(); });

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (dot) dot.style.transition = 'none';
    }
  })();
</script>