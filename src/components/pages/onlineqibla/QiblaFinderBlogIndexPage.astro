---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import QiblaFinderFaq from './QiblaFinderFaq.astro';
import CopyText from '../../CopyText.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, SITE_URL } from '../../../i18n/utils';
import { qiblaProse } from '../../../i18n/qiblaProse';
import { qiblaSupport } from '../../../i18n/qiblaSupport';
import { supportCopy } from '../../../i18n/supportCopy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = qiblaSupport[lang] ?? qiblaSupport.en;
const page = qiblaProse[lang] ?? qiblaProse.en;
const shared = supportCopy[lang] ?? supportCopy.en;

const posts = copy.posts;
const siteUrl = SITE_URL;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: t('page.qibla.title'), item: `${siteUrl}/onlineqibla/` },
    { '@type': 'ListItem', position: 3, name: t('page.blog.title'), item: `${siteUrl}/onlineqibla/blog/` },
  ],
};
---
<Layout
  title={copy.blogTitle}
  description={copy.blogDesc}
  keywords={copy.keywords}
  ogImage="/og-image.png"
  ogImageAlt={copy.blogTitle}
  breadcrumbLd={breadcrumbLd}>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlineqibla/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {copy.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.blog.title')}</h1>
    <p class="text-xs text-mute font-mono mb-4">{shared.updated}</p>

    {copy.blogIntro.map((paragraph) => (
      <CopyText text={paragraph} />
    ))}

    <ul class="space-y-8 mt-10">
      {posts.map((post) => (
        <li class="border-b border-hairline pb-6">
          <p class="text-xs text-mute font-mono mb-2">{post.date}</p>
          <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mb-2">
            <a href={post.href} class="hover:text-link transition-colors">{post.title}</a>
          </h2>
          <p class="text-body text-base leading-relaxed">{post.desc}</p>
        </li>
      ))}
    </ul>
  <QiblaFinderFaq heading={page.faqH} questions={page.faq} />
  </main>
  <Footer />
</Layout>
