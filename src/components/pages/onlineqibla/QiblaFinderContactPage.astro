---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import ContactForm from '../../ContactForm.astro';
import QiblaFinderFaq from './QiblaFinderFaq.astro';
import CopyText from '../../CopyText.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, SITE_URL } from '../../../i18n/utils';
import { qiblaProse } from '../../../i18n/qiblaProse';
import { qiblaSupport } from '../../../i18n/qiblaSupport';
import { supportCopy } from '../../../i18n/supportCopy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = qiblaSupport[lang] ?? qiblaSupport.en;
const page = qiblaProse[lang] ?? qiblaProse.en;
const shared = supportCopy[lang] ?? supportCopy.en;
const contact = copy.contact;

const siteUrl = SITE_URL;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: t('page.qibla.title'), item: `${siteUrl}/onlineqibla/` },
    { '@type': 'ListItem', position: 3, name: t('page.contact.title'), item: `${siteUrl}/onlineqibla/contact/` },
  ],
};
---
<Layout
  title={contact.contactTitle}
  description={contact.contactDesc}
  keywords={copy.keywords}
  ogImage="/og-image.png"
  ogImageAlt={contact.contactTitle}
  breadcrumbLd={breadcrumbLd}>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlineqibla/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {copy.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.contact.title')}</h1>
    <p class="text-xs text-mute font-mono mb-8">{shared.updated}</p>
    <p class="text-body text-base leading-relaxed mb-6">
      {contact.contactIntro}
    </p>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{contact.howH}</h2>
    {contact.how.map((paragraph) => (
      <CopyText text={paragraph} />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{contact.fixesH}</h2>
    <ul class="list-disc pl-6 space-y-2 text-body text-base leading-relaxed mb-4">
      {contact.fixes.map((fix) => (
        <li><strong>{fix.h}:</strong> {fix.p}</li>
      ))}
    </ul>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{contact.tellH}</h2>
    {contact.tell.map((paragraph) => (
      <CopyText text={paragraph} />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{contact.emailH}</h2>
    <p class="text-body text-base leading-relaxed mb-4">
      {contact.emailPre}<a href="mailto:hello@instanten.com" class="text-link hover:underline">hello@instanten.com</a>{contact.emailPost}
    </p>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{contact.sendH}</h2>
    <ContactForm />

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{contact.extraH}</h2>
    {contact.extra.map((paragraph) => (
      <CopyText text={paragraph} />
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{contact.responseH}</h2>
    {contact.response.map((paragraph) => (
      <CopyText text={paragraph} />
    ))}
    <p class="text-body text-base leading-relaxed mb-4">
      {contact.guidesPre}<a href={translatePath('/onlineqibla/blog/')} class="text-link hover:underline">{contact.guidesLink}</a>{contact.guidesPost}
    </p>
  <QiblaFinderFaq heading={page.faqH} questions={page.faq} />
  </main>
  <Footer />
</Layout>
