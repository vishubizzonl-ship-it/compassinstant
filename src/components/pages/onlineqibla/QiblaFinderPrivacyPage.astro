---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import LegalSections from '../../LegalSections.astro';
import QiblaFinderFaq from './QiblaFinderFaq.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, SITE_URL } from '../../../i18n/utils';
import { supportCopy } from '../../../i18n/supportCopy';
import { qiblaProse } from '../../../i18n/qiblaProse';
import { qiblaSupport } from '../../../i18n/qiblaSupport';
import { qiblaLegal } from '../../../i18n/qiblaLegal';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = supportCopy[lang] ?? supportCopy.en;
const page = qiblaProse[lang] ?? qiblaProse.en;
const seo = qiblaSupport[lang] ?? qiblaSupport.en;
const legal = qiblaLegal[lang] ?? qiblaLegal.en;

/**
 * The shared policy, with the Qibla finder's own location clauses spliced in:
 * "1a" and "1b" straight after "1. Information We Collect", and "2a" straight
 * after "2. Cookies". The numbering of every other section stays exactly as it is on
 * the rest of the site.
 */
const sections = [
  ...copy.privacy.sections.slice(0, 2),
  { h: legal.privacy1aH, paras: legal.privacy1a },
  { h: legal.privacy1bH, paras: legal.privacy1b },
  ...copy.privacy.sections.slice(2, 3),
  { h: legal.privacy2aH, paras: legal.privacy2a },
  ...copy.privacy.sections.slice(3),
];

const siteUrl = SITE_URL;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: t('page.qibla.title'), item: `${siteUrl}/onlineqibla/` },
    { '@type': 'ListItem', position: 3, name: t('page.privacy.title'), item: `${siteUrl}/onlineqibla/privacy/` },
  ],
};
---
<Layout
  title={`${t('page.privacy.title')} — ${t('page.qibla.title')}`}
  description={seo.aboutDesc}
  keywords={seo.keywords}
  ogImage="/og-image.png"
  ogImageAlt={t('page.privacy.title')}
  breadcrumbLd={breadcrumbLd}>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlineqibla/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {seo.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.privacy.title')}</h1>
    <p class="text-xs text-mute font-mono mb-8">{copy.updated}</p>

    <LegalSections
      sections={sections}
      contactHref={translatePath('/onlineqibla/contact/')}
      contactLabel={copy.contactLink}
      contactCta={copy.about.contactCta}
      toolLabel={copy.toolPhrase.qibla}
    />
  <QiblaFinderFaq heading={page.faqH} questions={page.faq} />
  </main>
  <Footer />
</Layout>
