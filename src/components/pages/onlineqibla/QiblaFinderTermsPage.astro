---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import LegalSections from '../../LegalSections.astro';
import CopyText from '../../CopyText.astro';
import QiblaFinderFaq from './QiblaFinderFaq.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, SITE_URL } from '../../../i18n/utils';
import { supportCopy } from '../../../i18n/supportCopy';
import { qiblaProse } from '../../../i18n/qiblaProse';
import { qiblaSupport } from '../../../i18n/qiblaSupport';
import { qiblaLegal } from '../../../i18n/qiblaLegal';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = supportCopy[lang] ?? supportCopy.en;
const page = qiblaProse[lang] ?? qiblaProse.en;
const seo = qiblaSupport[lang] ?? qiblaSupport.en;
const legal = qiblaLegal[lang] ?? qiblaLegal.en;

/**
 * The shared terms, adjusted for a Qibla finder: the intro and "1. Use of the
 * Service" name this tool, and the accuracy caveats sit inside "2. Accuracy
 * Disclaimer" straight after the bullet list, exactly where the English page
 * always had them.
 */
const sections = copy.terms.sections.map((section, index) => {
  if (index === 0) {
    return { ...section, paras: [legal.termsUse, ...section.paras.slice(1)] };
  }
  if (index === 1) {
    return {
      ...section,
      paras: [section.paras[0], ...legal.termsAccuracy, ...section.paras.slice(1)],
    };
  }
  return section;
});

const siteUrl = SITE_URL;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: t('page.qibla.title'), item: `${siteUrl}/onlineqibla/` },
    { '@type': 'ListItem', position: 3, name: t('page.terms.title'), item: `${siteUrl}/onlineqibla/terms/` },
  ],
};
---
<Layout
  title={`${t('page.terms.title')} — ${t('page.qibla.title')}`}
  description={seo.aboutDesc}
  keywords={seo.keywords}
  ogImage="/og-image.png"
  ogImageAlt={t('page.terms.title')}
  breadcrumbLd={breadcrumbLd}>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlineqibla/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {seo.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.terms.title')}</h1>
    <p class="text-xs text-mute font-mono mb-8">{copy.updated}</p>
    <CopyText
      text={legal.termsIntro}
      class="text-body text-base leading-relaxed mb-6"
      contactHref={translatePath('/onlineqibla/contact/')}
      contactLabel={copy.contactLink}
      contactCta={copy.about.contactCta}
      toolLabel={copy.toolPhrase.qibla}
    />

    <LegalSections
      sections={sections}
      contactHref={translatePath('/onlineqibla/contact/')}
      contactLabel={copy.contactLink}
      contactCta={copy.about.contactCta}
      toolLabel={copy.toolPhrase.qibla}
    />
  <QiblaFinderFaq heading={page.faqH} questions={page.faq} />
  </main>
  <Footer />
</Layout>
