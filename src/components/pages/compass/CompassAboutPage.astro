---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../Nav.astro';
import Footer from '../../Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { supportCopy } from '../../../i18n/supportCopy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = supportCopy[lang] ?? supportCopy.en;
const about = copy.about;
---
<Layout>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlinecompass/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {copy.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.about.title')}</h1>
    <p class="text-xs text-mute font-mono mb-8">{copy.updated}</p>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-8 mb-4">{about.whatH}</h2>
    {about.what.map((para) => (
      <p class="text-body text-base leading-relaxed mb-4">{para}</p>
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.missionH}</h2>
    {about.mission.map((para) => (
      <p class="text-body text-base leading-relaxed mb-4">{para}</p>
    ))}

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.featuresH}</h2>
    <ul class="list-disc pl-6 space-y-2 text-body text-base leading-relaxed mb-4">
      {about.featuresCompass.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.privacyH}</h2>
    <p class="text-body text-base leading-relaxed mb-4">
      {about.privacy} {about.privacyPre}<a href={translatePath('/onlinecompass/privacy/')} class="text-link hover:underline">{about.privacyLink}</a>{about.privacyPost}
    </p>

    <h2 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-10 mb-4">{about.contactH}</h2>
    <p class="text-body text-base leading-relaxed">
      {about.contact} <a href={translatePath('/onlinecompass/contact/')} class="text-link hover:underline">{about.contactCta}</a>
    </p>
  </main>
  <Footer />
</Layout>
