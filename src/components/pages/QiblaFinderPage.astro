---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import ToolBlog from '../ToolBlog.astro';
import QiblaFinderFaq from './onlineqibla/QiblaFinderFaq.astro';
import CopyText from '../CopyText.astro';
import { getToolBlog } from '../../i18n/blogs';
import { getLangFromUrl, useTranslations, SITE_URL } from '../../i18n/utils';
import { qiblaProse } from '../../i18n/qiblaProse';
import { qiblaSupport } from '../../i18n/qiblaSupport';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Long-form copy and SEO strings, with English as the fallback everywhere.
const copy = qiblaProse[lang] ?? qiblaProse.en;
const seo = qiblaSupport[lang] ?? qiblaSupport.en;
// FAQ questions that already live in the blog data, merged into the single
// FAQPage JSON-LD only. Falls back to English if a locale has no blog copy.
const toolBlogFaq =
  getToolBlog('onlineqibla', lang)?.faq ?? getToolBlog('onlineqibla', 'en')?.faq ?? [];

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
// Real production domain — breadcrumb and app schema must never point at a
// placeholder host, or Google drops the structured data.
const siteUrl = SITE_URL;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}${baseUrl}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('page.qibla.title'),
      item: `${siteUrl}${baseUrl}/onlineqibla/`,
    },
  ],
};

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: t('page.qibla.title'),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  url: `${siteUrl}${baseUrl}/onlineqibla/`,
  description: seo.toolDesc,
  inLanguage: lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: copy.faq.slice(0, 4).map((item) => item.q),
};

---<Layout
  title={seo.toolTitle}
  description={seo.toolDesc}
  keywords={seo.keywords}
  breadcrumbLd={breadcrumbLd}
  appLd={appLd}
  ogImage="/og-image.png"
  ogImageAlt={seo.ogAlt}
>
  <Nav />
  <main>
    <section class="py-2 lg:py-4 pt-2 lg:pt-4" aria-label={t('page.qibla.title')}>
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div id="qibla-card" class="bg-canvas-elevated border border-hairline rounded-md p-4 lg:p-6 shadow-[0px_1px_2px_rgba(0,0,0,0.03)] relative"
          data-t-ready={t('qibla.ui.ready')}
          data-t-bearing-prefix={t('qibla.ui.bearingPrefix')}
          data-t-gps={t('qibla.ui.gps')}
          data-t-gps-no-acc={t('qibla.ui.gpsNoAcc')}
          data-t-blocked={t('qibla.ui.blocked')}
          data-t-ip-approx={t('qibla.ui.ipApprox')}
          data-t-approx={t('qibla.ui.approx')}
          data-t-unavailable={t('qibla.ui.unavailable')}
          data-t-could-not={t('qibla.ui.couldNot')}
          data-t-calibrating={t('qibla.ui.calibrating')}
          data-t-heading-unavailable={t('qibla.ui.headingUnavailable')}
          data-t-https={t('qibla.ui.https')}
          data-t-no-orientation={t('qibla.ui.noOrientation')}
          data-t-tap-to-enable={t('qibla.ui.tapToEnable')}
          data-t-motion-denied={t('qibla.ui.motionDenied')}
          data-t-motion-blocked={t('qibla.ui.motionBlocked')}
        >
          <button type="button" id="qibla-fullscreen-btn" aria-label={t('qibla.ui.fullscreen')} class="absolute top-3 right-3 z-30 inline-flex items-center justify-center w-8 h-8 rounded-sm bg-canvas border border-hairline text-ink hover:bg-canvas-elevated transition-colors">
            <svg class="icon-enter" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <svg class="icon-exit hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
          </button>
          <div class="text-center mb-4">
            <h2 class="font-sans text-xl font-semibold tracking-tight text-ink">{t('qibla.ui.title')}</h2>
            <p class="text-xs text-mute font-mono mt-1 min-h-[1rem]" id="qibla-status" aria-live="polite">{t('qibla.ui.locating')}</p>
            <p class="text-3xl font-semibold tracking-tight tabular-nums text-ink mt-2 min-h-[2.25rem]" id="qibla-bearing">—</p>
            <!-- The script writes the source of the bearing here: GPS with accuracy,
                 or an approximate IP city. Without this element the visitor cannot
                 tell an exact reading from a guess. -->
            <p class="text-xs text-mute font-mono mt-1 min-h-[1rem]" id="qibla-location"></p>
          </div>

          <div class="relative flex items-center justify-center py-4 overflow-hidden" aria-label={t('qibla.ui.title')}>
            <div id="qibla-plus" class="absolute top-1/2 left-1/2 pointer-events-none z-20" style="transform: translate(-50%, -50%);">
              <div class="relative w-10 h-10">
                <div class="absolute left-1/2 top-0 bottom-0 w-[2px] bg-ink/80 -translate-x-1/2"></div>
                <div class="absolute top-1/2 left-0 right-0 h-[2px] bg-ink/80 -translate-y-1/2"></div>
              </div>
            </div>
            <div class="absolute top-1 left-1/2 -translate-x-1/2 z-20">
              <div class="w-0 h-0 border-l-[7px] border-r-[7px] border-b-[14px] border-l-transparent border-r-transparent border-b-error"></div>
            </div>
            <div id="qibla-dial" class="relative w-full max-w-[320px] aspect-square lg:w-80 lg:h-80 will-change-transform" style="transform: rotate(0deg); transition: none;">
              <svg viewBox="0 0 200 200" class="w-full h-full" aria-label={t('qibla.ui.title')}>
                <defs>
                  <radialGradient id="qibla-grad2" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="var(--color-canvas)" />
                    <stop offset="100%" stop-color="var(--color-canvas-elevated)" />
                  </radialGradient>
                </defs>
                <circle cx="100" cy="100" r="95" fill="url(#qibla-grad2)" stroke="var(--color-hairline)" stroke-width="1" />
                {Array.from({ length: 72 }, (_, i) => i * 5).map((deg) => {
                  const major = deg % 10 === 0;
                  const r1 = major ? 86 : 90;
                  const r2 = 94;
                  const rad = (deg * Math.PI) / 180;
                  const x1 = 100 + r1 * Math.sin(rad);
                  const y1 = 100 - r1 * Math.cos(rad);
                  const x2 = 100 + r2 * Math.sin(rad);
                  const y2 = 100 - r2 * Math.cos(rad);
                  return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="var(--color-mute)" stroke-width={major ? 1.5 : 0.7} opacity={major ? 0.9 : 0.4} />;
                })}
                {Array.from({ length: 36 }, (_, i) => i * 10).map((deg) => {
                  const rad = (deg * Math.PI) / 180;
                  const r = 78;
                  const x = 100 + r * Math.sin(rad);
                  const y = 100 - r * Math.cos(rad);
                  return <text x={x} y={y} text-anchor="middle" dominant-baseline="middle" font-family="Geist Mono, monospace" font-size="7" font-weight="500" fill="var(--color-mute)">{deg}</text>;
                })}
                <circle cx="100" cy="100" r="3" fill="var(--color-ink)" />
                <text x="100" y="45" text-anchor="middle" font-family="Geist Mono, monospace" font-size="11" font-weight="600" fill="var(--color-ink)" letter-spacing="2">N</text>
                <text x="139" y="61" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" font-weight="500" fill="var(--color-mute)" letter-spacing="1">NE</text>
                <text x="155" y="100" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" font-weight="500" fill="var(--color-mute)" letter-spacing="1">E</text>
                <text x="139" y="139" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" font-weight="500" fill="var(--color-mute)" letter-spacing="1">SE</text>
                <text x="100" y="155" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" font-weight="500" fill="var(--color-mute)" letter-spacing="1">S</text>
                <text x="61" y="139" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" font-weight="500" fill="var(--color-mute)" letter-spacing="1">SW</text>
                <text x="45" y="100" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" font-weight="500" fill="var(--color-mute)" letter-spacing="1">W</text>
                <text x="61" y="61" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" font-weight="500" fill="var(--color-mute)" letter-spacing="1">NW</text>
              </svg>
              <!-- Qibla marker as red line on the dial (rotates with dial) -->
              <div id="qibla-marker" class="absolute top-1/2 left-1/2 pointer-events-none" style="transform: translate(-50%, -50%) rotate(0deg) translateY(-120px);">
                <div class="w-[3px] h-6 bg-error rounded-sm shadow-md"></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
    <section class="py-16 lg:py-24" aria-label={t('page.qibla.how.enable')}>
      <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
        <h2 class="font-sans text-2xl font-semibold tracking-tight text-ink mb-8">{t('compass.how.title')}</h2>
        <div class="space-y-8">
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.qibla.how.enable')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.qibla.how.enable.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.qibla.how.calibrate')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.qibla.how.calibrate.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.qibla.how.offline')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.qibla.how.offline.desc')}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24 border-t border-hairline" aria-labelledby="about-online-qibla">
      <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
        <h2 id="about-online-qibla" class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-0 mb-4">
          {copy.aboutH}
        </h2>
        {copy.intro.map((paragraph) => (
          <CopyText text={paragraph} />
        ))}

        {copy.sections.map((section) => (
          <>
            <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
              {section.h}
            </h3>
            {section.paras.map((paragraph, index) => (
              <>
                <CopyText text={paragraph} />
                {section.list && index === (section.listAt ?? section.paras.length - 1) && (
                  <ul class="list-disc pl-6 mb-4 space-y-2 text-body text-base leading-relaxed">
                    {section.list.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </>
            ))}
          </>
        ))}
      </div>
    </section>

  <ToolBlog tool="onlineqibla" faqLd={false} />

  <section class="py-16 lg:py-24 border-t border-hairline" aria-labelledby="qibla-guides-title">
    <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
      <h2 id="qibla-guides-title" class="font-sans text-2xl sm:text-3xl font-semibold tracking-tight text-ink mb-6">
        {copy.guidesH}
      </h2>
      <ul class="flex flex-col gap-0 border border-hairline rounded-md overflow-hidden">
        {copy.guides.map((guide) => (
          <li class="border-b border-hairline last:border-b-0">
            <a href={guide.href} class="block px-4 py-4 hover:bg-canvas transition-colors">
              <span class="block font-sans text-base font-medium text-ink">{guide.title}</span>
              <span class="block text-sm text-body mt-1">{guide.desc}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="text-body text-base leading-relaxed mt-6">
        <a href="/onlineqibla/blog/" class="text-link hover:underline">{copy.guidesAll}</a>
      </p>
    </div>
  </section>
  <QiblaFinderFaq extraQuestions={toolBlogFaq} heading={copy.faqH} questions={copy.faq} />
  </main>
  <Footer />
</Layout>

<script>
  (function () {
    const dial = document.getElementById('qibla-dial');
    const card = document.getElementById('qibla-card');

    /**
     * Every visible string in this widget is rendered from ui.ts into a
     * data-t-* attribute on the card, because this module cannot call t()
     * itself. The English fallbacks below only ever apply if the attribute is
     * missing, which the build never allows.
     */
    function msg(key: string, fallback: string): string {
      return card?.getAttribute('data-t-' + key) ?? fallback;
    }
    const fsBtn = document.getElementById('qibla-fullscreen-btn');
    function syncFsIcon() {
      if (!fsBtn) return;
      const entering = !document.fullscreenElement;
      fsBtn.querySelector('.icon-enter')?.classList.toggle('hidden', !entering);
      fsBtn.querySelector('.icon-exit')?.classList.toggle('hidden', entering);
    }
    if (fsBtn) {
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else if (card && card.requestFullscreen) card.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', syncFsIcon);
      syncFsIcon();
    }
    const marker = document.getElementById('qibla-marker');
    const plus = document.getElementById('qibla-plus');
    const bearingEl = document.getElementById('qibla-bearing');
    const statusEl = document.getElementById('qibla-status');
    const locText = document.getElementById('qibla-location');

    const KAABA = { lat: 21.4225, lng: 39.8262 };

    function qiblaBearing(lat: number, lng: number) {
      const toRad = (deg: number) => (deg * Math.PI) / 180;
      const toDeg = (rad: number) => (rad * 180) / Math.PI;
      const phi1 = toRad(lat);
      const phi2 = toRad(KAABA.lat);
      const deltaLambda = toRad(KAABA.lng - lng);
      const y = Math.sin(deltaLambda) * Math.cos(phi2);
      const x =
        Math.cos(phi1) * Math.sin(phi2) -
        Math.sin(phi1) * Math.cos(phi2) * Math.cos(deltaLambda);
      return (toDeg(Math.atan2(y, x)) + 360) % 360;
    }

    function applyBearing(bearing: number) {
      if (bearingEl) bearingEl.textContent = bearing.toFixed(1) + '°';
      if (marker) marker.style.transform = `translate(-50%, -50%) rotate(${bearing}deg) translateY(-120px)`;
      if (statusEl) statusEl.textContent = msg('ready', 'Qibla ready');
      if (locText) locText.textContent = msg('bearing-prefix', 'Qibla bearing: ') + bearing.toFixed(1) + '°';
    }

    type Coords = { lat: number; lng: number; accuracy?: number };

    /** The device's own position — the exact answer. Asks permission once. */
    function locateWithGps(): Promise<Coords | null> {
      if (!('geolocation' in navigator)) return Promise.resolve(null);
      return new Promise((resolve) => {
        navigator.geolocation.getCurrentPosition(
          (pos) =>
            resolve({
              lat: pos.coords.latitude,
              lng: pos.coords.longitude,
              accuracy: pos.coords.accuracy,
            }),
          () => resolve(null),
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
        );
      });
    }

    /**
     * City-level guess from the IP address. Only used when the visitor blocks or
     * has no GPS — it can be a whole city out, so the tool says so on screen.
     */
    async function locateWithIp(): Promise<Coords | null> {
      try {
        const r = await fetch('https://ipapi.co/json/');
        const data = await r.json();
        if (data && typeof data.latitude === 'number' && typeof data.longitude === 'number') {
          return { lat: data.latitude, lng: data.longitude };
        }
      } catch {}
      return null;
    }

    function setLocationLabel(text: string) {
      if (locText) locText.textContent = text;
    }

    async function getLocation() {
      if (statusEl) statusEl.textContent = msg('locating', 'Locating…');

      const gps = await locateWithGps();
      if (gps) {
        applyBearing(qiblaBearing(gps.lat, gps.lng));
        const acc = gps.accuracy ? Math.round(gps.accuracy) : null;
        setLocationLabel(
          acc !== null
            ? msg('gps', 'Qibla bearing from your location (GPS ±{acc} m)').replace(
                '{acc}',
                String(acc),
              )
            : msg('gps-no-acc', 'Qibla bearing from your location (GPS)'),
        );
        return;
      }

      if (statusEl) statusEl.textContent = msg('blocked', 'Location blocked — estimating your city…');
      const ip = await locateWithIp();
      if (ip) {
        applyBearing(qiblaBearing(ip.lat, ip.lng));
        setLocationLabel(
          msg('ip-approx', 'Approximate bearing from your IP city — allow location access for an exact one'),
        );
        if (statusEl) statusEl.textContent = msg('approx', 'Approximate location');
        return;
      }

      if (statusEl) statusEl.textContent = msg('unavailable', 'Location unavailable');
      setLocationLabel(msg('could-not', 'Could not determine location — allow location access and reload.'));
    }

    type E = DeviceOrientationEvent & { webkitCompassHeading?: number | null; alpha?: number | null; beta?: number | null; gamma?: number | null; absolute?: boolean };

    function normalize(deg: number) {
      return ((deg % 360) + 360) % 360;
    }

    function getAbsoluteHeading(event: E): number | null {
      const wch = event.webkitCompassHeading;
      if (typeof wch === 'number' && Number.isFinite(wch)) {
        return normalize(wch);
      }
      const isAbsolute = event.type === 'deviceorientationabsolute' || event.absolute === true;
      if (isAbsolute && typeof event.alpha === 'number' && Number.isFinite(event.alpha)) {
        return normalize(360 - event.alpha);
      }
      return null;
    }

    const recent: number[] = [];
    const RECENT_MAX = 8;
    let targetRotation = 0;
    let currentRotation = 0;
    let rafId: number | null = null;
    let hasHeading = false;

    let plusTargetX = 0;
    let plusTargetY = 0;
    let plusCurrentX = 0;
    let plusCurrentY = 0;
    let plusRaf: number | null = null;

    function smoothPlusLoop() {
      plusCurrentX += (plusTargetX - plusCurrentX) * 0.15;
      plusCurrentY += (plusTargetY - plusCurrentY) * 0.15;
      if (plus) {
        plus.style.transform = `translate(calc(-50% + ${plusCurrentX.toFixed(1)}px), calc(-50% + ${plusCurrentY.toFixed(1)}px))`;
      }
      const dx = plusTargetX - plusCurrentX;
      const dy = plusTargetY - plusCurrentY;
      if (Math.hypot(dx, dy) > 0.1) plusRaf = requestAnimationFrame(smoothPlusLoop);
      else plusRaf = null;
    }

    function smoothLoop() {
      let delta = ((targetRotation - currentRotation + 540) % 360) - 180;
      currentRotation += delta * 0.06;
      currentRotation = normalize(currentRotation);
      if (dial) dial.style.transform = 'rotate(' + currentRotation.toFixed(2) + 'deg)';
      if (Math.abs(delta) > 0.05) rafId = requestAnimationFrame(smoothLoop);
      else rafId = null;
    }

    function handleOrientation(event: E) {
      const heading = getAbsoluteHeading(event);
      // plus leveling (always)
      const beta = typeof event.beta === 'number' ? event.beta : 0;
      const gamma = typeof event.gamma === 'number' ? event.gamma : 0;
      const scale = 2.5;
      const maxR = 120;
      let px = Math.max(-60, Math.min(60, gamma)) * scale;
      let py = Math.max(-60, Math.min(60, beta)) * scale;
      const dist = Math.hypot(px, py);
      if (dist > maxR) {
        const s = maxR / dist;
        px *= s;
        py *= s;
      }
      plusTargetX = px;
      plusTargetY = py;
      if (plusRaf === null) plusRaf = requestAnimationFrame(smoothPlusLoop);

      if (heading === null) {
        if (typeof event.alpha === 'number') {
          if (statusEl) statusEl.textContent = msg('calibrating', 'Calibrating compass…');
        } else {
          if (statusEl) statusEl.textContent = msg('heading-unavailable', 'Heading unavailable');
        }
        return;
      }

      recent.push(heading);
      if (recent.length > RECENT_MAX) recent.shift();
      let sx = 0, sy = 0;
      for (const h of recent) {
        const r = (h * Math.PI) / 180;
        sx += Math.sin(r);
        sy += Math.cos(r);
      }
      const avg = normalize((Math.atan2(sx, sy) * 180) / Math.PI);

      const currentHeading = normalize(-targetRotation);
      let deltaHeading = ((avg - currentHeading + 540) % 360) - 180;
      if (Math.abs(deltaHeading) < 2.5) {
        if (!hasHeading) { hasHeading = true; if (statusEl) statusEl.textContent = ''; }
        return;
      }

      const newRotation = normalize(-avg);
      let deltaRotation = ((newRotation - targetRotation + 540) % 360) - 180;
      if (Math.abs(deltaRotation) < 2.5) {
        if (!hasHeading) { hasHeading = true; if (statusEl) statusEl.textContent = ''; }
        return;
      }

      targetRotation = newRotation;
      if (!hasHeading) { hasHeading = true; if (statusEl) statusEl.textContent = ''; }
      if (rafId === null) rafId = requestAnimationFrame(smoothLoop);
    }

    function cleanup() {
      window.removeEventListener('deviceorientation', handleOrientation as any);
      window.removeEventListener('deviceorientationabsolute', handleOrientation as any, true);
      if (rafId !== null) cancelAnimationFrame(rafId);
      if (plusRaf !== null) cancelAnimationFrame(plusRaf);
    }

    function addListeners() {
      if ('ondeviceorientationabsolute' in window) {
        window.addEventListener('deviceorientationabsolute', handleOrientation as any, true);
      } else {
        // TS narrows `window` to never inside this branch; the cast keeps the
        // fallback listener type-safe.
        (window as Window).addEventListener('deviceorientation', handleOrientation as any);
      }
    }

    async function enable() {
      if (!window.isSecureContext) {
        if (statusEl) statusEl.textContent = msg('https', 'Sensor access requires HTTPS.');
        return;
      }
      if (!window.DeviceOrientationEvent) {
        if (statusEl) statusEl.textContent = msg('no-orientation', 'Device orientation not supported.');
        return;
      }
      const doe: any = window.DeviceOrientationEvent;
      if (typeof doe.requestPermission === 'function') {
        try {
          const res = await doe.requestPermission();
          if (res !== 'granted') {
            if (statusEl) statusEl.textContent = msg('motion-denied', 'Motion permission denied.');
            return;
          }
        } catch {
          if (statusEl) statusEl.textContent = msg('motion-blocked', 'Motion permission blocked.');
          return;
        }
      }
      if (statusEl) statusEl.textContent = msg('calibrating', 'Calibrating compass…');
      addListeners();
    }

    // init
    if (!window.isSecureContext) {
      if (statusEl) statusEl.textContent = msg('https', 'Sensor access requires HTTPS.');
    } else if (!window.DeviceOrientationEvent) {
      if (statusEl) statusEl.textContent = msg('no-orientation', 'Device orientation not supported.');
    } else {
      const doe: any = window.DeviceOrientationEvent;
      if (typeof doe.requestPermission === 'function') {
        if (statusEl) statusEl.textContent = msg('tap-to-enable', 'Tap screen to enable motion sensors.');
        enable();
      } else {
        if (statusEl) statusEl.textContent = msg('calibrating', 'Calibrating compass…');
        addListeners();
      }
    }

    document.addEventListener('click', () => {
      const doe: any = window.DeviceOrientationEvent;
      if (doe && typeof doe.requestPermission === 'function') enable();
    }, { once: true });

    window.addEventListener('beforeunload', cleanup);
    window.addEventListener('pagehide', cleanup);

    // auto location (no permission needed)
    getLocation();
  })();
</script>