---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import ToolBlog from '../ToolBlog.astro';
import SpeedometerFaq from './onlinespeedometer/SpeedometerFaq.astro';
import { getToolBlog } from '../../i18n/blogs';

const toolBlogFaq = getToolBlog('onlinespeedometer', 'en')?.faq ?? [];
import { getLangFromUrl, useTranslations, SITE_URL } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
// Real production domain — breadcrumb and app schema must never point at a
// placeholder host, or Google drops the structured data.
const siteUrl = SITE_URL;

const KWS =
  'online speedometer, free online speedometer, online speedometer free, online speedometer test, online speedometer mph, hardspeedometer test, speedometer online train, speedometer test online, speedometer digital, gps speedometer online, my speed km/h, speedometer online, live speed test, live speedometer, zspeed, gps speedometer';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Speedometer', item: `${siteUrl}${baseUrl}/onlinespeedometer/` },
  ],
};

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Online Speedometer',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  url: `${siteUrl}${baseUrl}/onlinespeedometer/`,
  description:
    'Free online speedometer: a GPS speedometer online that shows your live speed in km/h or mph, plus max speed, average speed, altitude and trip time in the browser. No install, no sign-up.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Live speedometer in km/h, mph, m/s and knots',
    'Online speedometer test with max and average speed',
    'GPS speedometer online on mobile and desktop browsers',
    'No install and no account',
  ],
};

---
<Layout
  title={lang === 'en' ? 'Online Speedometer — Free GPS Speed Test in km/h & mph' : undefined}
  description={lang === 'en' ? 'Free online speedometer: measure your live speed in km/h or mph with GPS, plus max speed, average speed, altitude and trip time. No install, no sign-up.' : undefined}
  keywords={lang === 'en' ? KWS : undefined}
  breadcrumbLd={breadcrumbLd}
  appLd={appLd}
  ogImage="/og-image.png"
  ogImageAlt={lang === 'en' ? 'Online speedometer — free GPS speed test showing live speed in km/h and mph in the browser' : undefined}
>
  <Nav />
  <main>
    <section class="py-2 lg:py-4 pt-2 lg:pt-4" aria-label={t('page.speed.title')}>
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div id="speed-card" class="bg-canvas-elevated border border-hairline rounded-md p-4 lg:p-6 shadow-[0px_1px_2px_rgba(0,0,0,0.03)] relative">
          <button type="button" id="speed-fullscreen-btn" aria-label="Fullscreen" class="absolute top-3 right-3 z-30 inline-flex items-center justify-center w-8 h-8 rounded-sm bg-canvas border border-hairline text-ink hover:bg-canvas-elevated transition-colors">
            <svg class="icon-enter" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <svg class="icon-exit hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
          </button>
          <div class="text-center mb-4">
            <h2 class="font-sans text-xl font-semibold tracking-tight text-ink">{t('speed.ui.title')}</h2>
            <p class="text-xs text-mute font-mono mt-1">{t('speed.ui.gpsActive')}</p>
            <div class="flex gap-2 justify-center mt-3">
              <button onclick="startTrip()" id="start-btn" data-start={t('speed.ui.start')} data-stop={t('speed.ui.stop')} class="inline-flex rounded-sm bg-ink text-canvas-elevated text-sm font-medium px-4 py-2 hover:bg-ink/90 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none active:scale-95">{t('speed.ui.start')}</button>
              <button onclick="resetTrip()" class="inline-flex rounded-sm bg-ink text-canvas-elevated text-sm font-medium px-4 py-2 hover:bg-ink/90 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none active:scale-95">{t('speed.ui.reset')}</button>
              <button onclick="recordSpeed()" id="record-btn" class="inline-flex rounded-sm bg-canvas-elevated border border-hairline text-ink text-sm font-medium px-4 py-2 hover:border-ink/20 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none active:scale-95">{t('speed.ui.record')}</button>
            </div>
          </div>

          <div class="text-center py-4 mb-4">
            <p class="text-5xl lg:text-6xl font-semibold tracking-tighter text-ink tabular-nums transition-transform duration-200 origin-center" id="speed-display">0</p>
            <div class="flex items-center justify-center gap-3 mt-2">
              <p class="text-sm text-mute font-mono" id="speed-unit">KM/H</p>
              <div class="relative" id="unit-dropdown-wrapper">
                <button onclick="toggleUnitMenu()" id="unit-btn" class="inline-flex items-center gap-1.5 rounded-sm bg-canvas-elevated border border-hairline text-ink text-xs font-medium px-3 py-1.5 hover:border-ink/20 transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none" aria-label="Change unit" aria-expanded="false" aria-haspopup="true">
                  <span id="unit-label">KM/H</span>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2 4 6 8 10 4"/></svg>
                </button>
                <div id="unit-menu" class="hidden absolute right-0 top-full mt-2 w-32 bg-canvas-elevated border border-hairline rounded-md shadow-lg overflow-hidden z-50">
                  <button onclick="selectUnit(0)" class="flex w-full items-center justify-between px-4 py-2.5 text-sm text-body hover:text-ink hover:bg-canvas transition-colors">KM/H</button>
                  <button onclick="selectUnit(1)" class="flex w-full items-center justify-between px-4 py-2.5 text-sm text-body hover:text-ink hover:bg-canvas transition-colors">MPH</button>
                  <button onclick="selectUnit(2)" class="flex w-full items-center justify-between px-4 py-2.5 text-sm text-body hover:text-ink hover:bg-canvas transition-colors">M/S</button>
                  <button onclick="selectUnit(3)" class="flex w-full items-center justify-between px-4 py-2.5 text-sm text-body hover:text-ink hover:bg-canvas transition-colors">KN</button>
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
            <div class="p-2 rounded-sm bg-canvas border border-hairline">
              <p class="text-[10px] text-mute font-mono uppercase tracking-wide">{t('speed.ui.max')}</p>
              <p id="max-speed" class="text-lg font-semibold tabular-nums text-ink">0.0</p>
              <p class="text-[10px] text-faint" id="max-unit">KM/H</p>
            </div>
            <div class="p-2 rounded-sm bg-canvas border border-hairline">
              <p class="text-[10px] text-mute font-mono uppercase tracking-wide">{t('speed.ui.average')}</p>
              <p id="avg-speed" class="text-lg font-semibold tabular-nums text-ink">0.0</p>
              <p class="text-[10px] text-faint" id="avg-unit">KM/H</p>
            </div>
            <div class="p-2 rounded-sm bg-canvas border border-hairline">
              <p class="text-[10px] text-mute font-mono uppercase tracking-wide">{t('speed.ui.altitude')}</p>
              <p id="altitude" class="text-lg font-semibold tabular-nums text-ink">—</p>
              <p class="text-[10px] text-faint">m</p>
            </div>
            <div class="p-2 rounded-sm bg-canvas border border-hairline">
              <p class="text-[10px] text-mute font-mono uppercase tracking-wide">{t('speed.ui.duration')}</p>
              <p id="duration" class="text-lg font-semibold tabular-nums text-ink">00:00</p>
              <p class="text-[10px] text-faint">m:s</p>
            </div>
          </div>

          <!-- Same records list, but inside the card: fullscreen only shows the
               card, so this is where the list can appear while the speed readout
               stays exactly where it already is. Hidden outside fullscreen. -->
          <div id="records-in-card" class="records-in-card">
            <div class="flex items-center justify-between gap-3 mb-1">
              <p class="text-[10px] text-mute font-mono uppercase tracking-wide">{t('speed.records.title')}</p>
              <button type="button" onclick="clearRecords()" id="records-clear-card" class="text-[10px] text-mute hover:text-ink underline underline-offset-2 transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">{t('speed.records.clear')}</button>
            </div>
            <p id="records-empty-card" class="text-xs text-mute leading-relaxed">{t('speed.records.empty')}</p>
            <ul id="records-list-card" class="hidden divide-y divide-hairline" data-remove-label={t('speed.records.remove')}></ul>
          </div>
        </div>
      </div>
    </section>
    <section class="pb-8" aria-labelledby="speed-records-title">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div class="bg-canvas-elevated border border-hairline rounded-md p-4 lg:p-6">
          <div class="flex items-center justify-between gap-3 mb-3">
            <h2 id="speed-records-title" class="font-sans text-base font-semibold tracking-tight text-ink">{t('speed.records.title')}</h2>
            <button type="button" onclick="clearRecords()" id="records-clear" class="hidden text-xs text-mute hover:text-ink underline underline-offset-2 transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">{t('speed.records.clear')}</button>
          </div>
          <p id="records-empty" class="text-sm text-mute leading-relaxed">{t('speed.records.empty')}</p>
          <ul id="records-list" class="hidden divide-y divide-hairline" aria-live="polite" data-remove-label={t('speed.records.remove')}></ul>
        </div>
      </div>
    </section>
    <section class="py-16 lg:py-24" aria-label={t('page.speed.how.enable')}>
      <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
        <h2 class="font-sans text-2xl font-semibold tracking-tight text-ink mb-8">{t('compass.how.title')}</h2>
        <div class="space-y-8">
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.speed.how.enable')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.speed.how.enable.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.speed.how.calibrate')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.speed.how.calibrate.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.speed.how.offline')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.speed.how.offline.desc')}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24 border-t border-hairline" aria-labelledby="about-online-speedometer">
      <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
        <h2 id="about-online-speedometer" class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-0 mb-4">
          The free online speedometer that reads your real speed
        </h2>
        <p class="text-body text-base leading-relaxed mb-4">
          This <strong>online speedometer</strong> turns the phone in your hand into a working speed
          readout in one tap. There is nothing to install, no account to create and no download
          waiting time — you open the page, allow location once, and the number on screen is your
          speed right now. It is a <strong>free online speedometer</strong> built for one job: telling
          you how fast you are actually moving, on a bike, in a car, on a train, or on foot.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          If you have ever searched for “<em>speedometer online</em>”, “<em>live speedometer</em>” or
          “<em>gps speedometer</em>”, you already know the problem. Your car dashboard is optimistic by
          a few percent, your bike computer needs mounting, and you just want an answer. A
          <strong>live speed test</strong> removes the guesswork in two seconds, with a number instead
          of a needle you have to squint at.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          What this speedometer online actually shows you
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          The <strong>speedometer digital</strong> readout is the headline: one large number that
          updates as you move. Under it you get the trip figures that make the tool genuinely useful —
          your maximum speed, your average speed, the distance covered, the altitude you are at and
          how long the trip has been running. The unit button switches between km/h, mph, m/s and
          knots, so the same page answers “<em>my speed km/h</em>” on a road in India and mph on a
          motorway abroad without a second tool.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          Everything comes from the GPS chip your phone already has. The page reads your position
          once a second, works out how far you moved, and converts that into speed. That is why a
          <strong>GPS speedometer online</strong> can be more honest than a dashboard: it measures
          your movement over the ground rather than counting wheel rotations against an assumed tyre
          size.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          How to run a speedometer test online
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          Open the page outdoors with a clear view of the sky — GPS needs to see satellites, and a
          reading taken indoors or in a tunnel will stall or jump. Allow location when the browser
          asks, then press Start and begin moving. The first few seconds are the sensor settling; after
          that the number tracks smoothly.
        </p>
        <ul class="list-disc pl-6 mb-4 space-y-2 text-body text-base leading-relaxed">
          <li>Take the phone out of a metal case and keep it near a window or on a dash mount.</li>
          <li>Press Reset before a run so max and average belong to that trip only.</li>
          <li>Switch the unit first — km/h for road use, mph for UK and US speed limits.</li>
          <li>Keep the screen awake; a locked phone can pause GPS updates on some browsers.</li>
          <li>Compare the reading with a fixed distance and a stopwatch if you want to check accuracy.</li>
        </ul>
        <p class="text-body text-base leading-relaxed mb-4">
          That is the whole <strong>online speedometer test</strong>: no cables, no OBD reader, no
          subscription. A <strong>speedometer test online</strong> also gives you a second opinion when
          a dashboard looks wrong after a wheel or tyre change, because the number comes from movement
          rather than from a calibrated instrument.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          Speedometer online, offline and everything between
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          The tool is <strong>online speedometer free</strong> of charge, but once the page has loaded
          it keeps working without a data connection — the GPS receiver does the work, not a server. If
          what you want is a <strong>speedometer online train</strong> check on a route with patchy
          signal, that matters: the page stays open and keeps counting while the signal drops.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          On a train, a bus or a long drive it is also the only speed readout you get as a passenger.
          Look for a straight stretch, note the number, and compare it with the route timetable if you
          are curious. Anything searched as <em>zspeed</em> or similar brand names does the same thing;
          this page simply does it without an app, which is why people keep it in a tab.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          Accuracy you can expect from a phone speedometer
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          A phone GPS reads speed to within roughly 1–2 km/h in open sky, which is tighter than most
          car dashes. Dashes are deliberately optimistic — manufacturers allow a few percent, and tyre
          wear or a different wheel size adds more. So if the numbers disagree, run a
          <strong>online speedometer mph</strong> reading on the same stretch and trust the one that
          repeats itself.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          Expect two limits. Tall buildings, trees and tunnels cause dropouts, and the reading holds
          for a few seconds before it drops back to zero until the fix returns. And rapid acceleration can lag by a second,
          because the chip averages positions. Neither matters for normal use, but do not treat any
          <strong>HardSpeedometer test</strong> at high speed as a precision measurement — for that a
          calibrated unit still wins.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          Who the free speedometer is for
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          Cyclists use it to confirm a bike computer. Drivers use it to check a dashboard after changing
          wheels. Passengers use it out of curiosity on a highway or a train. Runners and walkers use
          the average speed figure as a pace check. And anyone comparing a car with a hire car, a
          parent's car or a new purchase gets a neutral number without installing anything.
        </p>
        <p class="text-body text-base leading-relaxed mb-4">
          Because the tool is browser based, it works the same on Android, iPhone, tablet or laptop
          (laptops rarely have GPS, so a phone is the practical choice). Your location is used to
          calculate speed and is never uploaded, so a <strong>speedometer digital</strong> check on a
          borrowed phone leaves nothing behind.
        </p>

        <h3 class="font-sans text-base sm:text-lg font-semibold tracking-tight text-ink mt-10 mb-3">
          The short version
        </h3>
        <p class="text-body text-base leading-relaxed mb-4">
          Open the page, allow location, press Start, and read your speed in km/h or mph. Reset between
          trips so max and average stay honest, keep the phone outdoors for a clean signal, and expect
          a phone GPS to be slightly more accurate than a car dash. Whether you came here from a
          <em>speedometer online</em> search, a <em>live speed test</em> query or a
          <strong>speedometer test online</strong> on a resale car, the answer is the same page — free,
          private, and no install.
        </p>
      </div>
    </section>

  <ToolBlog tool="onlinespeedometer" faqLd={false} />

  <section class="py-16 lg:py-24 border-t border-hairline" aria-labelledby="speed-guides-title">
    <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
      <h2 id="speed-guides-title" class="font-sans text-2xl sm:text-3xl font-semibold tracking-tight text-ink mb-6">
        Latest guides from the Speedometer blog
      </h2>
      <ul class="flex flex-col gap-0 border border-hairline rounded-md overflow-hidden">
        <li class="border-b border-hairline last:border-b-0">
          <a href="/onlinespeedometer/blog/how-to-use-an-online-speedometer/" class="block px-4 py-4 hover:bg-canvas transition-colors">
            <span class="block font-sans text-base font-medium text-ink">How to Use an Online Speedometer (Step-by-Step)</span>
            <span class="block text-sm text-body mt-1">Allow location, press Start, choose km/h or mph, and read your live speed.</span>
          </a>
        </li>
        <li class="border-b border-hairline last:border-b-0">
          <a href="/onlinespeedometer/blog/how-accurate-is-a-phone-speedometer/" class="block px-4 py-4 hover:bg-canvas transition-colors">
            <span class="block font-sans text-base font-medium text-ink">How Accurate Is a Phone Speedometer?</span>
            <span class="block text-sm text-body mt-1">Typical GPS error, how it compares with a dashboard, and three tests to run.</span>
          </a>
        </li>
        <li class="border-b border-hairline last:border-b-0">
          <a href="/onlinespeedometer/blog/speedometer-units-kmh-mph-knots/" class="block px-4 py-4 hover:bg-canvas transition-colors">
            <span class="block font-sans text-base font-medium text-ink">Speedometer Units: km/h, mph, m/s and Knots</span>
            <span class="block text-sm text-body mt-1">When to use each unit, and how to convert in your head.</span>
          </a>
        </li>
      </ul>
      <p class="text-body text-base leading-relaxed mt-6">
        <a href="/onlinespeedometer/blog/" class="text-link hover:underline">See all Online Speedometer guides →</a>
      </p>
    </div>
  </section>
  <SpeedometerFaq extraQuestions={toolBlogFaq} heading="Frequently asked questions about the online speedometer" />
  </main>
  <Footer />
</Layout>

<style>
  /* Hidden everywhere except fullscreen. */
  .records-in-card {
    display: none;
  }

  /* Fullscreen: the card is the whole screen and simply grows downwards. The
     recorded list sits in normal flow, directly below the last element of the
     speedometer (the Max / Average / Altitude / Duration boxes), so nothing can
     ever overlap them. When the list gets longer than the screen it runs off the
     bottom and the card itself scrolls — every record is reachable, and the
     speedometer above is not restyled or re-positioned at all. */
  #speed-card:fullscreen,
  #speed-card:-webkit-full-screen {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: 2rem;
  }
  #speed-card:fullscreen .records-in-card,
  #speed-card:-webkit-full-screen .records-in-card {
    display: block;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-hairline, #ebebeb);
  }
</style>
<script>
  (function () {
    const card = document.getElementById('speed-card');
    const fsBtn = document.getElementById('speed-fullscreen-btn');

    function syncFsIcon() {
      if (!fsBtn) return;
      const entering = !document.fullscreenElement;
      fsBtn.querySelector('.icon-enter')?.classList.toggle('hidden', !entering);
      fsBtn.querySelector('.icon-exit')?.classList.toggle('hidden', entering);
    }
    if (fsBtn) {
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else if (card && card.requestFullscreen) card.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', () => {
        syncFsIcon();
        renderRecords();
      });
      syncFsIcon();
    }
    let maxSp = 0;
    let totalSp = 0;
    let count = 0;
    let startTime = 0;
    let interval: number | null = null;
    let currentSpeedKmh = 0;
    let unitIndex = 0;
    let running = false;

    const units = [
      { label: 'KM/H', factor: 1 },
      { label: 'MPH', factor: 0.621371 },
      { label: 'M/S', factor: 0.277778 },
      { label: 'KN', factor: 0.539957 },
    ];

    const speedEl = document.getElementById('speed-display');
    const maxEl = document.getElementById('max-speed');
    const avgEl = document.getElementById('avg-speed');
    const altEl = document.getElementById('altitude');
    const durEl = document.getElementById('duration');
    const startBtn = document.getElementById('start-btn');
    const speedUnitEl = document.getElementById('speed-unit');
    const maxUnitEl = document.getElementById('max-unit');
    const avgUnitEl = document.getElementById('avg-unit');
    const unitBtn = document.getElementById('unit-btn');
    const unitLabel = document.getElementById('unit-label');
    const unitMenu = document.getElementById('unit-menu');
    const unitWrapper = document.getElementById('unit-dropdown-wrapper');
    const recordsList = document.getElementById('records-list');
    const recordsEmpty = document.getElementById('records-empty');
    const recordsClear = document.getElementById('records-clear');
    // The copy inside the card, which is what fullscreen can show.
    const recordsListCard = document.getElementById('records-list-card');
    const recordsEmptyCard = document.getElementById('records-empty-card');
    const recordsClearCard = document.getElementById('records-clear-card');

    function label() { return units[unitIndex].label; }
    function factor() { return units[unitIndex].factor; }
    function fmt(n: number) { return (n * factor()).toFixed(1); }

    function renderUnits() {
      const l = label();
      if (speedUnitEl) speedUnitEl.textContent = l;
      if (maxUnitEl) maxUnitEl.textContent = l;
      if (avgUnitEl) avgUnitEl.textContent = l;
      if (unitLabel) unitLabel.textContent = l;
    }

    function renderSpeeds() {
      if (speedEl) speedEl.textContent = fmt(currentSpeedKmh);
      if (maxEl) maxEl.textContent = fmt(maxSp);
      if (avgEl && count > 0) avgEl.textContent = fmt(totalSp / count);
    }

    (window as any).toggleUnitMenu = function () {
      if (!unitMenu || !unitBtn) return;
      unitMenu.classList.toggle('hidden');
      unitBtn.setAttribute('aria-expanded', String(!unitMenu.classList.contains('hidden')));
    };

    (window as any).selectUnit = function (i: number) {
      unitIndex = i;
      if (unitMenu) unitMenu.classList.add('hidden');
      if (unitBtn) unitBtn.setAttribute('aria-expanded', 'false');
      renderUnits();
      renderSpeeds();
      renderRecords();
    };

    document.addEventListener('click', function (e) {
      if (unitWrapper && !unitWrapper.contains(e.target as Node)) {
        if (unitMenu) unitMenu.classList.add('hidden');
        if (unitBtn) unitBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (unitMenu) unitMenu.classList.add('hidden');
        if (unitBtn) unitBtn.setAttribute('aria-expanded', 'false');
      }
    });

    function animateSpeed() {
      if (!speedEl) return;
      speedEl.classList.add('scale-110');
      setTimeout(() => { if (speedEl) speedEl.classList.remove('scale-110'); }, 250);
    }

    (window as any).startTrip = function () {
      if (running) {
        running = false;
        if (interval) clearInterval(interval);
        interval = null;
        if (startBtn) startBtn.textContent = startBtn.dataset.start || 'Start';
        animateSpeed();
        return;
      }
      running = true;
      startTime = Date.now();
      if (interval) clearInterval(interval);
      interval = window.setInterval(() => {
        if (durEl && startTime) {
          const sec = Math.floor((Date.now() - startTime) / 1000);
          const m = Math.floor(sec / 60);
          const s = sec % 60;
          durEl.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
        }
      }, 1000);
      if (startBtn) startBtn.textContent = startBtn.dataset.stop || 'Stop';
      animateSpeed();
    };

    (window as any).resetTrip = function () {
      running = false;
      maxSp = 0;
      totalSp = 0;
      count = 0;
      startTime = 0;
      currentSpeedKmh = 0;
      if (interval) clearInterval(interval);
      interval = null;
      if (startBtn) startBtn.textContent = startBtn.dataset.start || 'Start';
      if (speedEl) speedEl.textContent = '0';
      if (maxEl) maxEl.textContent = '0.0';
      if (avgEl) avgEl.textContent = '0.0';
      if (altEl) altEl.textContent = '—';
      if (durEl) durEl.textContent = '00:00';
      animateSpeed();
    };

    // --- recorded speeds -----------------------------------------------------
    // "Record" saves whatever the big display shows right now, so a speed can be
    // shown to someone later instead of being read off a screen that has moved
    // on. The list lives in localStorage, so it survives a reload or a closed
    // tab, and every entry can be removed one by one or all at once.
    const REC_KEY = 'speedometer-records';
    const REC_LIMIT = 100;

    type Rec = { kmh: number; t: number };

    function readRecords(): Rec[] {
      try {
        const raw = localStorage.getItem(REC_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return [];
        return parsed
          .filter((r: any) => r && typeof r.kmh === 'number' && Number.isFinite(r.kmh) && typeof r.t === 'number')
          .slice(0, REC_LIMIT);
      } catch {
        return [];
      }
    }

    let records: Rec[] = readRecords();

    function saveRecords() {
      try {
        localStorage.setItem(REC_KEY, JSON.stringify(records));
      } catch {
        // Private mode with storage disabled: the list still works for this visit.
      }
    }

    function recordTime(t: number) {
      try {
        return new Date(t).toLocaleString(undefined, {
          day: '2-digit',
          month: 'short',
          hour: '2-digit',
          minute: '2-digit',
        });
      } catch {
        return new Date(t).toLocaleTimeString();
      }
    }

    function makeRow(rec: Rec, index: number, removeLabel: string) {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between gap-3 py-2.5';

      const left = document.createElement('div');
      left.className = 'flex items-baseline gap-1.5 min-w-0';

      const value = document.createElement('span');
      value.className = 'text-lg font-semibold tabular-nums text-ink';
      value.textContent = fmt(rec.kmh);

      const unit = document.createElement('span');
      unit.className = 'text-[11px] text-mute font-mono';
      unit.textContent = label();

      left.append(value, unit);

      const right = document.createElement('div');
      right.className = 'flex items-center gap-3 shrink-0';

      const when = document.createElement('span');
      when.className = 'text-xs text-mute font-mono';
      when.textContent = recordTime(rec.t);

      const del = document.createElement('button');
      del.type = 'button';
      del.className =
        'text-mute hover:text-ink transition-colors leading-none px-1 focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm';
      del.setAttribute('aria-label', removeLabel);
      del.textContent = '\u00d7';
      del.addEventListener('click', () => removeRecord(index));

      right.append(when, del);
      li.append(left, right);
      return li;
    }

    function paint(listEl: HTMLElement | null, emptyEl: HTMLElement | null) {
      if (!listEl || !emptyEl) return;
      const has = records.length > 0;
      emptyEl.classList.toggle('hidden', has);
      listEl.classList.toggle('hidden', !has);
      listEl.textContent = '';
      const removeLabel = listEl.dataset.removeLabel || 'Remove';
      records.forEach((rec, i) => listEl.append(makeRow(rec, i, removeLabel)));
    }

    function renderRecords() {
      // Both copies are painted together, so a recording appears in the page and
      // in fullscreen at the same instant.
      paint(recordsList, recordsEmpty);
      paint(recordsListCard, recordsEmptyCard);
      if (recordsClear) recordsClear.classList.toggle('hidden', records.length === 0);
      if (recordsClearCard) recordsClearCard.classList.toggle('hidden', records.length === 0);
    }

    function removeRecord(index: number) {
      records.splice(index, 1);
      saveRecords();
      renderRecords();
    }

    (window as any).recordSpeed = function () {
      records.unshift({ kmh: currentSpeedKmh, t: Date.now() });
      if (records.length > REC_LIMIT) records.length = REC_LIMIT;
      saveRecords();
      renderRecords();
      animateSpeed();
    };

    (window as any).clearRecords = function () {
      records = [];
      saveRecords();
      renderRecords();
    };

    // --- live speed ----------------------------------------------------------
    // Three things used to make a parked device show a speed:
    //   1. coords.speed is noisy on Android and often reports 0.1-0.5 m/s while
    //      the phone sits on a table.
    //   2. the distance fallback compared two fixes ~1 s apart, where GPS jitter
    //      is bigger than the real movement.
    //   3. an unusable fix kept the previous reading, so after stopping the
    //      display froze at the last speed and never came back to zero.
    // The rules below keep the readout on the device's actual speed: a dead band,
    // a longer measuring window with a jitter floor, and a hold that expires.
    // GPS noise on a parked phone reads up to ~0.5 m/s (1.8 km/h), so anything
    // under 2 km/h is shown as zero. Walking is 4-5 km/h and is unaffected.
    const SPEED_ZERO_KMH = 2;
    const HOLD_MS = 3000; // how long a missing fix may keep the last reading
    const MIN_SPAN_MS = 4000; // never derive speed from a shorter interval
    const MAX_SPAN_MS = 15000; // or from a gap longer than this
    const MAX_ACCURACY_M = 40; // worse than this and speed off the delta is junk

    function haversineKm(a: GeolocationCoordinates, b: GeolocationCoordinates) {
      const R = 6371;
      const toRad = (d: number) => (d * Math.PI) / 180;
      const dLat = toRad(b.latitude - a.latitude);
      const dLon = toRad(b.longitude - a.longitude);
      const s =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(toRad(a.latitude)) * Math.cos(toRad(b.latitude)) * Math.sin(dLon / 2) ** 2;
      return 2 * R * Math.asin(Math.min(1, Math.sqrt(s)));
    }

    type Fix = { lat: number; lon: number; t: number; acc: number };
    const fixes: Fix[] = [];
    let lastGoodWall = 0;
    let lastFixWall = 0;

    const metres = (a: Fix, b: Fix) =>
      haversineKm({ latitude: a.lat, longitude: a.lon } as GeolocationCoordinates, {
        latitude: b.lat,
        longitude: b.lon,
      } as GeolocationCoordinates) * 1000;

    /**
     * Speed from the distance travelled over a window of at least MIN_SPAN_MS.
     * A longer window is what makes this usable while standing still: over 4 s the
     * jitter averages out instead of turning into a fake 12 km/h.
     * Returns null when there is not enough history to say anything trustworthy.
     */
    function pushFix(pos: GeolocationPosition): Fix {
      const fix: Fix = {
        lat: pos.coords.latitude,
        lon: pos.coords.longitude,
        t: pos.timestamp || Date.now(),
        acc: typeof pos.coords.accuracy === 'number' ? pos.coords.accuracy : 99,
      };
      fixes.push(fix);
      while (fixes.length > 30) fixes.shift();
      return fix;
    }

    function speedFromWindow(fix: Fix): number | null {
      const acc = fix.acc;
      if (acc > MAX_ACCURACY_M) return null;

      // The newest fix that is at least MIN_SPAN old — i.e. the shortest usable
      // window. Taking the oldest fix instead would compare against a position
      // from half a minute ago and reject perfectly good readings.
      let idx = -1;
      for (let i = fixes.length - 2; i >= 0; i--) {
        if (fix.t - fixes[i].t >= MIN_SPAN_MS) {
          idx = i;
          break;
        }
      }
      if (idx < 0) return null;
      const oldest = fixes[idx];
      const span = (fix.t - oldest.t) / 1000;
      if (span > MAX_SPAN_MS / 1000) return null;

      const net = metres(oldest, fix);
      // Positions wander by roughly their own accuracy. Anything shorter than
      // this is the chip breathing, not the device moving.
      const floor = Math.max(2.5, Math.min(oldest.acc, acc) * 0.4);
      if (net < floor) return 0;

      // Jitter goes back and forth, so the path travelled is far longer than the
      // distance between the two ends. Real movement keeps them about equal.
      let path = 0;
      for (let i = idx + 1; i < fixes.length; i++) path += metres(fixes[i - 1], fixes[i]);
      const kmh = (net / span) * 3.6;
      if (kmh < 10 && path > net * 2.5) return 0;

      return kmh > 300 ? null : kmh;
    }

    /** A reading is only allowed to change the display if it can be trusted. */
    function applySpeed(measured: number | null) {
      const wall = Date.now();
      if (measured === null) {
        // Hold the last reading briefly while a fix is missing, then let go.
        // Without the timeout a parked device stayed frozen at its last speed.
        if (lastGoodWall && wall - lastGoodWall > HOLD_MS && currentSpeedKmh !== 0) {
          currentSpeedKmh = 0;
          renderSpeeds();
        }
        return;
      }
      lastGoodWall = wall;
      const next = measured <= SPEED_ZERO_KMH ? 0 : measured;
      if (Math.abs(next - currentSpeedKmh) < 0.05 && next !== 0) return;
      currentSpeedKmh = next;
      if (running) {
        maxSp = Math.max(maxSp, currentSpeedKmh);
        totalSp += currentSpeedKmh;
        count++;
      }
      renderSpeeds();
    }

    if (navigator.geolocation) {
      navigator.geolocation.watchPosition(
        (pos) => {
          lastFixWall = Date.now();
          const reported = pos.coords.speed;
          const acc = typeof pos.coords.accuracy === 'number' ? pos.coords.accuracy : 99;
          const usableReport =
            typeof reported === 'number' && Number.isFinite(reported) && reported >= 0 && acc <= MAX_ACCURACY_M;
          // Always record the fix, whichever source ends up driving the display:
          // if the chip stops reporting coords.speed the window is already warm
          // instead of leaving a four second hole.
          const fix = pushFix(pos);
          applySpeed(usableReport ? reported * 3.6 : speedFromWindow(fix));

          const alt = pos.coords.altitude;
          if (altEl) altEl.textContent = alt === null || alt === undefined ? '—' : Math.round(alt).toString();
        },
        () => {},
        { enableHighAccuracy: true, maximumAge: 1000 },
      );

      // Fixes can stop arriving altogether when the device is idle. Without this
      // watchdog the display would keep the last speed forever.
      window.setInterval(() => {
        if (!lastFixWall) return;
        if (Date.now() - lastFixWall > HOLD_MS && currentSpeedKmh !== 0) {
          currentSpeedKmh = 0;
          renderSpeeds();
        }
      }, 1000);
    }

    renderUnits();
    renderSpeeds();
    renderRecords();
  })();
</script>
