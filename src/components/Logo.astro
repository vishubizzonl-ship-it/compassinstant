---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;
const dim =
  size === 'sm' ? 'h-8 w-8' : size === 'lg' ? 'h-11 w-11' : 'h-9 w-9';
---
<span
  class={`inline-flex ${dim} items-center justify-center shrink-0 ${className}`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 32 32"
    class="h-full w-full"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="32" height="32" rx="8" fill="var(--color-ink)" />
    <circle
      cx="16"
      cy="16"
      r="11"
      stroke="var(--color-canvas)"
      stroke-width="1.25"
      opacity="0.28"
    />
    <path d="M16 7 L19 16 L16 13.5 L13 16 Z" fill="var(--color-canvas)" />
    <path
      d="M16 25 L13 16 L16 18.5 L19 16 Z"
      fill="var(--color-canvas)"
      opacity="0.4"
    />
    <circle cx="16" cy="16" r="1.7" fill="var(--color-canvas)" />
  </svg>
</span>