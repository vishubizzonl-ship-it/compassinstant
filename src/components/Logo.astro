---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  /** Wordmark text. Pass `null` to render the mark only. */
  wordmark?: string | null;
  /** Render in brand lime instead of black. */
  tone?: 'ink' | 'brand';
}

/**
 * Mark family: squircle tile + white cut-out glyph (same construction as
 * the OpenDesignMD mark) + heavy tight wordmark.
 */
const { size = 'md', class: className = '', wordmark = 'onlinecompass', tone = 'ink' } = Astro.props;
const dim = size === 'sm' ? 'h-7 w-7' : size === 'lg' ? 'h-11 w-11' : 'h-9 w-9';
const text = size === 'sm' ? 'text-[17px]' : size === 'lg' ? 'text-[24px]' : 'text-[20px]';
const tile = tone === 'brand' ? '#9FE870' : '#0E0F0C';
const glyph = tone === 'brand' ? '#0E0F0C' : '#FFFFFF';
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <span class={`inline-flex ${dim} items-center justify-center shrink-0`} aria-hidden="true">
    <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- squircle tile: same superellipse construction as the reference mark -->
      <path
        d="M7.5 0H16.5C22.65 0 24 1.35 24 7.5V16.5C24 22.65 22.65 24 16.5 24H7.5C1.35 24 0 22.65 0 16.5V7.5C0 1.35 1.35 0 7.5 0Z"
        fill={tile}
      ></path>
      <!-- compass needle, cut-out style: chunky north blade + muted tail -->
      <path d="M12 3.6 L18 15.9 L12 12.9 L6 15.9 Z" fill={glyph}></path>
      <path d="M12 20.4 L7.6 13.4 L12 15.5 L16.4 13.4 Z" fill={glyph} opacity="0.45"></path>
      <!-- pivot dot -->
      <circle cx="12" cy="12" r="1.15" fill={tile}></circle>
    </svg>
  </span>
  {wordmark && (
    <span
      class={`font-sans ${text} font-black lowercase tracking-[-0.055em] text-[#0E0F0C] dark:text-white whitespace-nowrap leading-none`}
    >
      {wordmark}
    </span>
  )}
</span>
