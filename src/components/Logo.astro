---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  /** Wordmark text. Pass `null` to render the mark only. */
  wordmark?: string | null;
}

/**
 * Wise-family logo: bold lime-green needle glyph + heavy 900 lowercase wordmark.
 * Wise tokens: brand green #9FE870, ink #0E0F0C, ink-deep #163300.
 */
const { size = 'md', class: className = '', wordmark = 'onlinecompass' } = Astro.props;
const dim = size === 'sm' ? 'h-7 w-7' : size === 'lg' ? 'h-11 w-11' : 'h-9 w-9';
const text = size === 'sm' ? 'text-[17px]' : size === 'lg' ? 'text-[24px]' : 'text-[20px]';
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <span class={`inline-flex ${dim} items-center justify-center shrink-0`} aria-hidden="true">
    <svg
      viewBox="0 0 32 32"
      class="h-full w-full"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- North needle: Wise brand green, chunky flag-arrow geometry -->
      <path d="M16 2.5 L27.5 22.5 L16 17.4 L4.5 22.5 Z" fill="#9FE870" />
      <!-- South tail: deep-green second tone for depth -->
      <path
        d="M16 29.5 L11.4 21.2 L16 23.4 L20.6 21.2 Z"
        fill="#163300"
        opacity="0.85"
      />
      <!-- Pivot -->
      <circle cx="16" cy="16.2" r="1.6" fill="#0E0F0C" />
    </svg>
  </span>
  {wordmark && (
    <span
      class={`font-sans ${text} font-black lowercase tracking-[-0.045em] text-[#0E0F0C] dark:text-white whitespace-nowrap leading-none`}
    >
      {wordmark}
    </span>
  )}
</span>
