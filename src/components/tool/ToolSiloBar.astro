---
import { toolBySlug, tools } from '../../data/tools';

interface Props {
  tool: string;
}
const { tool } = Astro.props;
const current = toolBySlug(tool);
const here = Astro.url.pathname;
const accent = current?.accent ?? '#0E0F0C';
const items = current
  ? [
      { label: current.name, href: `/${current.slug}/` },
      { label: 'Guides', href: `/${current.slug}/blog/` },
      { label: 'About', href: `/${current.slug}/about/` },
      { label: 'Contact', href: `/${current.slug}/contact/` },
      { label: 'Privacy', href: `/${current.slug}/privacy/` },
      { label: 'Terms', href: `/${current.slug}/terms/` },
    ]
  : [];
---
<div class="border-b border-hairline bg-[#FAFAF8]">
  <div class="mx-auto flex max-w-[80rem] items-center gap-2 overflow-x-auto px-5 py-2 text-sm lg:px-8">
    <a href="/" class="shrink-0 rounded-full border border-hairline bg-canvas px-3 py-1 font-semibold text-ink">← All tools</a>
    {items.map((item) => (
      <a
        href={item.href}
        class:list={['shrink-0 rounded-full px-3 py-1 transition-colors', here === item.href ? 'font-semibold text-ink' : 'text-body hover:text-ink']}
        style={here === item.href ? `background:${accent}1f` : ''}
      >
        {item.label}
      </a>
    ))}
  </div>
</div>
