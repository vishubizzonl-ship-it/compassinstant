---
interface Props {
  html: string;
}
const { html } = Astro.props;
---
<div
  class="silo-prose mx-auto max-w-[64rem] px-5 pb-16 pt-8 lg:px-8"
  set:html={html}
/>
<style>
  .silo-prose :global(h2) {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 2.5rem 0 0.75rem;
  }
  .silo-prose :global(p) {
    color: var(--color-body);
    font-size: 1rem;
    line-height: 1.75;
    margin: 0 0 1rem;
  }
  .silo-prose :global(p.lead) {
    font-size: 1.125rem;
    color: var(--color-body);
    border-left: 3px solid var(--color-brand);
    padding-left: 1rem;
    margin-bottom: 2rem;
  }
  .silo-prose :global(p.meta) {
    font-size: 0.75rem;
    color: var(--color-mute);
    font-family: var(--font-mono);
    margin-top: 2.5rem;
  }
  .silo-prose :global(ul),
  .silo-prose :global(ol) {
    color: var(--color-body);
    line-height: 1.75;
    margin: 0 0 1.25rem;
    padding-left: 1.35rem;
  }
  .silo-prose :global(ul) { list-style: disc; }
  .silo-prose :global(ol) { list-style: decimal; }
  .silo-prose :global(li) { margin-bottom: 0.4rem; }
  .silo-prose :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .silo-prose :global(strong) { color: var(--color-ink); font-weight: 600; }
  .silo-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: #f4f4f2;
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .silo-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 0 0 1.5rem;
  }
  .silo-prose :global(th) {
    text-align: left;
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-hairline);
    padding: 0.6rem 0.75rem;
    background: #fafaf8;
  }
  .silo-prose :global(td) {
    color: var(--color-body);
    border-bottom: 1px solid var(--color-hairline);
    padding: 0.6rem 0.75rem;
  }
</style>
