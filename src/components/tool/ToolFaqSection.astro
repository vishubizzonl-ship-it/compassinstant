---
import Faq from './Faq.astro';
import { toolBySlug } from '../../data/tools';

interface Props {
  tool: string;
}
const { tool } = Astro.props;
const current = toolBySlug(tool);
const faqs = current?.faqs ?? [];
const accent = current?.accent ?? '#0E0F0C';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: current?.name,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  url: `https://instanten.com/${tool}/`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: current?.seoDescription,
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'instanten', item: 'https://instanten.com/' },
    { '@type': 'ListItem', position: 2, name: current?.name, item: `https://instanten.com/${tool}/` },
  ],
})} />
<Faq faqs={faqs} accent={accent} title={`${current?.name} — questions and answers`} />
