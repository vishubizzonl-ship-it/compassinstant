---
import type { Faq } from '../../data/tools';

interface Props {
  faqs: Faq[];
  title?: string;
  accent?: string;
}
const { faqs, title = 'Frequently asked questions', accent = '#0E0F0C' } = Astro.props;
---
<section class="mx-auto max-w-[64rem] px-5 py-12 lg:px-8" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="mb-6 font-sans text-2xl font-bold tracking-tight text-ink">{title}</h2>
  <div class="divide-y divide-hairline border-y border-hairline">
    {faqs.map((faq) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-semibold text-ink">
          <span>{faq.q}</span>
          <span class="mt-0.5 shrink-0 text-lg leading-none transition-transform group-open:rotate-45" style={`color:${accent}`} aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-body">{faq.a}</p>
      </details>
    ))}
  </div>
</section>
