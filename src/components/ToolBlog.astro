---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getToolBlog } from '../i18n/blogs';

interface Props {
  tool: string;
  /** Emit the FAQPage JSON-LD. Set false when the page emits its own. */
  faqLd?: boolean;
}

const { tool, faqLd = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const blog = getToolBlog(tool, lang);

const faqJsonLd =
  blog && blog.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: blog.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
          },
        })),
      }
    : null;

// The blog heading and description are derived from the tool's own heading
// and description shown above the tool, so the two always stay in sync.
const toolKeyMap: Record<string, string> = {
  "compass": "compass",
  "onlinecompass": "compass",
  "onlinebubblelevel": "bubble",
  "onlinespeedometer": "speed",
  "onlineqibla": "qibla",
};
const toolKey = toolKeyMap[tool];
const blogTitle = blog?.title ?? (toolKey ? t(`page.${toolKey}.title` as any) : "");
const blogDesc = blog?.intro?.[0] ?? (toolKey ? t(`page.${toolKey}.desc` as any) : "");
---

{blog && (
  <section class="py-16 lg:py-24 border-t border-hairline" aria-labelledby="tool-blog-title">
    <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
      <h1 id="tool-blog-title" class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-6">
        {blogTitle}
      </h1>
      <p class="text-body text-base leading-relaxed mb-6">{blogDesc}</p>
      {blog.intro && blog.intro.map((p, i) => (
        i === 0 ? null : <p class="text-body text-base leading-relaxed mb-6">{p}</p>
      ))}
      {blog.sections.map((section) => (
        <div class="mt-10">
          <h3 class="font-sans text-xl sm:text-2xl font-semibold tracking-tight text-ink mb-4">
            {section.heading}
          </h3>
          {section.paragraphs.map((paragraph) => (
            <p class="text-body text-base leading-relaxed mb-4">{paragraph}</p>
          ))}
          {section.list && (
            <ul class="list-disc pl-6 space-y-2 text-body text-base leading-relaxed mb-4">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.table && (
            <div class="overflow-x-auto mb-4">
              <table class="w-full text-sm text-body border border-hairline">
                <thead>
                  <tr class="bg-canvas-elevated">
                    {section.table.headers.map((h) => (
                      <th class="border border-hairline px-3 py-2 text-left font-semibold text-ink">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td class="border border-hairline px-3 py-2">{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      ))}
      {blog.faq.length > 0 && (
        <div class="mt-12">
          <h3 class="font-sans text-2xl font-semibold tracking-tight text-ink mb-6">
            {t('section.faq')}
          </h3>
          <div class="flex flex-col gap-0 border border-hairline rounded-md overflow-hidden">
            {blog.faq.map((item) => (
              <details class="border-b border-hairline last:border-b-0">
                <summary class="font-sans text-base font-medium text-ink px-4 py-3 cursor-pointer list-none flex items-center justify-between gap-2">
                  {item.q}
                  <span aria-hidden="true" class="text-mute">▾</span>
                </summary>
                <p class="text-body text-base leading-relaxed px-4 pb-3">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      )}
      {blog.outro && (
        <p class="text-body text-base leading-relaxed mt-10 italic">{blog.outro}</p>
      )}
    </div>
  </section>
)}
{faqLd && faqJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
)}