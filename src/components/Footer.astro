---
import Logo from "./Logo.astro";
import {
  getLangFromUrl,
  getLocalizedPath,
  routePaths,
  stripLocale,
  useTranslations,
  useTranslatedPath,
  languages,
} from '../i18n/utils';

const url = new URL(Astro.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentPath = stripLocale(url.pathname);
const safePath = (routePaths as readonly string[]).includes(currentPath)
  ? currentPath
  : '/';

/**
 * The footer follows the header: inside a tool's own pages it stays within that
 * tool (its Tools column is dropped and its links point at that tool's own
 * pages). Markup and classes are unchanged; only the link targets differ.
 */
const toolSlugs = ['compass', 'bubble-level', 'speedometer', 'qibla-finder'] as const;
type FooterTool = (typeof toolSlugs)[number];

const firstSegment = currentPath.split('/').filter(Boolean)[0] ?? '';
const activeTool: FooterTool | null =
  currentPath === '/'
    ? 'compass'
    : (toolSlugs as readonly string[]).includes(firstSegment)
      ? (firstSegment as FooterTool)
      : null;

const toolHome: Record<FooterTool, string> = {
  compass: '/compass/',
  'bubble-level': '/bubble-level/',
  speedometer: '/speedometer/',
  'qibla-finder': '/qibla-finder/',
};

const toolTaglines: Record<FooterTool, string> = {
  compass:
    'A live compass in your browser — find north, read your heading, and measure bearing in degrees. Built with modern web sensors, no download and no account.',
  'bubble-level':
    'A bubble level in your browser — check level and plumb, read tilt in degrees. Built with modern web sensors, no download and no account.',
  speedometer:
    'A speedometer in your browser — GPS speed with max, average, altitude and trip time. Built with modern web sensors, no download and no account.',
  'qibla-finder':
    'A Qibla finder in your browser — the bearing to the Kaaba from your own location. Built with modern web sensors, no download and no account.',
};

const toolLinks = activeTool
  ? []
  : [
      { href: '/compass/', label: t('nav.compass') },
      { href: '/bubble-level/', label: t('nav.bubble') },
      { href: '/speedometer/', label: t('nav.speed') },
      { href: '/qibla-finder/', label: t('nav.qibla') },
    ];
---

<footer class="border-t border-hairline bg-canvas" aria-label={t('nav.footer')}>
  <div class="mx-auto max-w-7xl px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8">
      <div class="md:col-span-2">
        <a href={translatePath(activeTool ? toolHome[activeTool] : '/')} class="inline-flex items-center gap-2.5 rounded-full px-2 py-1 focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none" aria-label="onlinecompass — {t('nav.home')}">
          <Logo size="sm" />
          <span class="font-sans text-sm font-semibold tracking-tight text-ink">onlinecompass</span>
        </a>
        <p class="mt-4 text-sm text-body max-w-[24rem] leading-relaxed">
          {activeTool ? toolTaglines[activeTool] : t('footer.tagline')}
        </p>
      </div>

      {!activeTool && (
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wide text-mute mb-4">{t('footer.tools')}</h3>
        <ul class="space-y-2.5">
          {toolLinks.map((item) => (
            <li>
              <a href={translatePath(item.href)} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      )}

      <div>
        <h3 class="text-xs font-mono uppercase tracking-wide text-mute mb-4">{t('footer.company')}</h3>
        <ul class="space-y-2.5">
          {(activeTool
            ? [
                { href: `${toolHome[activeTool]}blog/`, label: 'Blog' },
                { href: `${toolHome[activeTool]}about/`, label: t('footer.about') },
                { href: `${toolHome[activeTool]}privacy/`, label: t('footer.privacy') },
                { href: `${toolHome[activeTool]}terms/`, label: t('footer.terms') },
                { href: `${toolHome[activeTool]}contact/`, label: t('footer.contact') },
              ]
            : [
                { href: '/blog/', label: 'Blog' },
                { href: '/about/', label: t('footer.about') },
                { href: '/privacy/', label: t('footer.privacy') },
                { href: '/terms/', label: t('footer.terms') },
                { href: '/contact/', label: t('footer.contact') },
              ]
          ).map((item) => (
            <li>
              <a href={translatePath(item.href)} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Language links: crawlable, hreflang-tagged equivalents of this page -->
    <div class="mt-10 pt-8 border-t border-hairline">
      <h3 class="text-xs font-mono uppercase tracking-wide text-mute mb-3">{t('footer.language')}</h3>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {Object.entries(languages).map(([code, name]) => (
          <li>
            <a
              href={getLocalizedPath(code as keyof typeof languages, safePath)}
              hreflang={code}
              lang={code}
              aria-current={code === lang ? 'true' : undefined}
              class:list={[
                'text-xs transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm',
                code === lang ? 'text-ink font-medium' : 'text-faint hover:text-body',
              ]}
            >
              {name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-8 pt-8 border-t border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-faint">© 2026 onlinecompass.com. {t('footer.rights')} {t('footer.built')}</p>
      <div class="flex gap-4">
        <a href="#" class="text-xs text-faint hover:text-body transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm" aria-label="Twitter">Twitter</a>
        <a href="#" class="text-xs text-faint hover:text-body transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm" aria-label="GitHub">GitHub</a>
      </div>
    </div>
  </div>
</footer>
