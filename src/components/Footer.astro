---
import Logo from "./Logo.astro";
import {
  getLangFromUrl,
  getLocalizedPath,
  routePaths,
  stripLocale,
  useTranslations,
  useTranslatedPath,
  languages,
} from '../i18n/utils';

const url = new URL(Astro.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentPath = stripLocale(url.pathname);
const safePath = (routePaths as readonly string[]).includes(currentPath)
  ? currentPath
  : '/';

const toolLinks = [
  { href: '/compass/', label: t('nav.compass') },
  { href: '/bubble-level/', label: t('nav.bubble') },
  { href: '/speedometer/', label: t('nav.speed') },
  { href: '/qibla-finder/', label: t('nav.qibla') },
];
---

<footer class="border-t border-hairline bg-canvas" aria-label={t('nav.footer')}>
  <div class="mx-auto max-w-7xl px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8">
      <div class="md:col-span-2">
        <a href={translatePath('/')} class="inline-flex items-center gap-2.5 rounded-full px-2 py-1 focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none" aria-label="instanten — {t('nav.home')}">
          <Logo size="sm" />
          <span class="font-sans text-sm font-semibold tracking-tight text-ink">instanten</span>
        </a>
        <p class="mt-4 text-sm text-body max-w-[24rem] leading-relaxed">
          {t('footer.tagline')}
        </p>
      </div>

      <div>
        <h3 class="text-xs font-mono uppercase tracking-wide text-mute mb-4">{t('footer.tools')}</h3>
        <ul class="space-y-2.5">
          {toolLinks.map((item) => (
            <li>
              <a href={translatePath(item.href)} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-mono uppercase tracking-wide text-mute mb-4">{t('footer.company')}</h3>
        <ul class="space-y-2.5">
          <li><a href={translatePath('/blog/')} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">Blog</a></li>
          <li><a href={translatePath('/about/')} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">{t('footer.about')}</a></li>
          <li><a href={translatePath('/privacy/')} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">{t('footer.privacy')}</a></li>
          <li><a href={translatePath('/terms/')} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">{t('footer.terms')}</a></li>
          <li><a href={translatePath('/contact/')} class="text-sm text-body hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm">{t('footer.contact')}</a></li>
        </ul>
      </div>
    </div>

    <!-- Language links: crawlable, hreflang-tagged equivalents of this page -->
    <div class="mt-10 pt-8 border-t border-hairline">
      <h3 class="text-xs font-mono uppercase tracking-wide text-mute mb-3">{t('footer.language')}</h3>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {Object.entries(languages).map(([code, name]) => (
          <li>
            <a
              href={getLocalizedPath(code as keyof typeof languages, safePath)}
              hreflang={code}
              lang={code}
              aria-current={code === lang ? 'true' : undefined}
              class:list={[
                'text-xs transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm',
                code === lang ? 'text-ink font-medium' : 'text-faint hover:text-body',
              ]}
            >
              {name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-8 pt-8 border-t border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-faint">© 2026 instanten.com. {t('footer.rights')} {t('footer.built')}</p>
      <div class="flex gap-4">
        <a href="#" class="text-xs text-faint hover:text-body transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm" aria-label="Twitter">Twitter</a>
        <a href="#" class="text-xs text-faint hover:text-body transition-colors focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none rounded-sm" aria-label="GitHub">GitHub</a>
      </div>
    </div>
  </div>
</footer>
