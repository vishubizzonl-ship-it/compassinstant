---
import SiloLayout from '../../../layouts/SiloLayout.astro';
import { SITE, toolBySlug } from '../../../data/tools';
import { postsByTool } from '../../../data/blog';

const tool = toolBySlug('bubble-level')!;
const posts = postsByTool('bubble-level');
const path = '/bubble-level/blog/';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${tool.name} guides`,
    url: SITE.url + path,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: tool.name, item: SITE.url + '/bubble-level/' },
      { '@type': 'ListItem', position: 3, name: 'Guides', item: SITE.url + path },
    ],
  },
];
---

<SiloLayout
  title={`${tool.name} Guides & Tutorials | ${SITE.name}`}
  description={`Practical guides for the ${tool.name}: how it works, how accurate it really is, how to fix common problems, and when to use dedicated hardware instead.`}
  path={path}
  tool="bubble-level"
  crumbs={[{ label: tool.name, href: `/bubble-level/` }, { label: 'Guides' }]}
  schemas={schemas}
>
  <section class="mx-auto max-w-[64rem] px-5 pb-20 pt-8 lg:px-8">
    <h1 class="font-sans text-[2.1rem] font-black leading-[1.05] tracking-[-0.04em] text-ink sm:text-4xl">
      {tool.name} guides
    </h1>
    <p class="mt-3 max-w-[56ch] text-base leading-relaxed text-body">{tool.tagline}</p>

    <ul class="mt-10 divide-y divide-hairline border-y border-hairline">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/bubble-level/blog/${post.slug}/`} class="font-sans text-xl font-bold tracking-tight text-ink hover:underline">
            {post.title}
          </a>
          <p class="mt-2 max-w-[64ch] text-sm leading-relaxed text-body">{post.description}</p>
          <p class="mt-2 text-xs text-mute">
            <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            {' · '}{post.minutes} min read
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-10">
      <a href="/bubble-level/" class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-bold text-white" style={`background:${tool.accent}`}>
        Open the {tool.name} →
      </a>
    </div>
  </section>
</SiloLayout>
