---
import SiloLayout from '../../../layouts/SiloLayout.astro';
import SiloProse from '../../../components/tool/SiloProse.astro';
import { SITE, toolBySlug } from '../../../data/tools';
import { siloContent } from '../../../data/silo-content';

const tool = toolBySlug('bubble-level')!;
const copy = siloContent['bubble-level'].privacy;
const path = '/bubble-level/privacy/';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: tool.name, item: SITE.url + '/bubble-level/' },
      { '@type': 'ListItem', position: 3, name: 'Privacy', item: SITE.url + path },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: copy.title,
    description: copy.description,
    url: SITE.url + path,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    about: { '@type': 'SoftwareApplication', name: tool.name, url: SITE.url + '/bubble-level/' },
  },
];

const siblings = [
  { label: 'About', href: '/bubble-level/about/' },
  { label: 'Contact', href: '/bubble-level/contact/' },
  { label: 'Privacy', href: '/bubble-level/privacy/' },
  { label: 'Terms', href: '/bubble-level/terms/' },
].filter((s) => s.href !== path);
---

<SiloLayout
  title={copy.title}
  description={copy.description}
  path={path}
  tool="bubble-level"
  crumbs={[{ label: tool.name, href: `/bubble-level/` }, { label: 'Privacy' }]}
  schemas={schemas}
>
  <article>
    <header class="mx-auto max-w-[64rem] px-5 pt-8 lg:px-8">
      <h1 class="font-sans text-[2.1rem] font-black leading-[1.05] tracking-[-0.04em] text-ink sm:text-4xl">
        {copy.h1}
      </h1>
    </header>

    <SiloProse html={copy.body} />

    <section class="mx-auto max-w-[64rem] px-5 pb-20 lg:px-8">
      <div class="rounded-3xl border border-hairline bg-[#FAFAF8] p-6">
        <p class="text-sm font-bold text-ink">More from {tool.name}</p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          <li>
            <a href="/bubble-level/" class="font-semibold underline decoration-hairline underline-offset-2 hover:decoration-ink" style={`color:${tool.accent}`}>
              Open the tool
            </a>
          </li>
          <li><a href="/bubble-level/blog/" class="text-body hover:text-ink">Guides</a></li>
          {siblings.map((s) => (
            <li><a href={s.href} class="text-body hover:text-ink">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</SiloLayout>
