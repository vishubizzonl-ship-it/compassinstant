---
import SiloLayout from '../../../layouts/SiloLayout.astro';
import SiloProse from '../../../components/tool/SiloProse.astro';
import { SITE, toolBySlug } from '../../../data/tools';
import { postsByTool } from '../../../data/blog';

const tool = toolBySlug('compass')!;

export function getStaticPaths() {
  return postsByTool('compass').map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const path = `/compass/blog/${post.slug}/`;
const related = postsByTool('compass').filter((p) => p.slug !== post.slug).slice(0, 2);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    dateModified: post.updated ?? post.date,
    inLanguage: 'en',
    mainEntityOfPage: { '@type': 'WebPage', '@id': SITE.url + path },
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    about: { '@type': 'SoftwareApplication', name: tool.name, url: SITE.url + '/compass/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: tool.name, item: SITE.url + '/compass/' },
      { '@type': 'ListItem', position: 3, name: 'Guides', item: SITE.url + '/compass/blog/' },
      { '@type': 'ListItem', position: 4, name: post.title, item: SITE.url + path },
    ],
  },
];
---

<SiloLayout
  title={`${post.title} | ${SITE.name}`}
  description={post.description}
  keywords={post.keywords}
  path={path}
  tool="compass"
  ogType="article"
  crumbs={[
    { label: tool.name, href: `/compass/` },
    { label: 'Guides', href: `/compass/blog/` },
    { label: post.title },
  ]}
  schemas={schemas}
>
  <article>
    <header class="mx-auto max-w-[64rem] px-5 pt-8 lg:px-8">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.1em]" style={`color:${tool.accent}`}>
        {tool.name} · guide
      </p>
      <h1 class="font-sans text-[2rem] font-black leading-[1.05] tracking-[-0.04em] text-ink sm:text-[2.6rem]">
        {post.title}
      </h1>
      <p class="mt-3 text-sm text-mute">
        <time datetime={post.date}>
          {new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {' · '}{post.minutes} min read
      </p>
    </header>

    <SiloProse html={post.body} />

    <section class="mx-auto max-w-[64rem] px-5 pb-20 lg:px-8">
      <div class="rounded-3xl p-6" style={`background:${tool.accentSoft}`}>
        <p class="text-base font-bold text-ink">Try it yourself</p>
        <p class="mt-1 text-sm text-body">{tool.tagline}</p>
        <a
          href="/compass/"
          class="mt-4 inline-flex rounded-full px-5 py-2.5 text-sm font-bold text-white"
          style={`background:${tool.accent}`}
        >
          Open the {tool.name} →
        </a>
      </div>

      {related.length > 0 && (
        <div class="mt-10">
          <h2 class="mb-4 font-sans text-lg font-bold tracking-tight text-ink">Keep reading</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {related.map((p) => (
              <li class="rounded-2xl border border-hairline p-5">
                <a href={`/compass/blog/${p.slug}/`} class="text-base font-bold tracking-tight text-ink hover:underline">
                  {p.title}
                </a>
                <p class="mt-1.5 text-sm leading-relaxed text-body">{p.description}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </article>
</SiloLayout>
