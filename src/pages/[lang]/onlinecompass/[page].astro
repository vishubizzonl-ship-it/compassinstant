---
/**
 * Localised copies of the compass silo pages: /es/onlinecompass/about/,
 * /ja/onlinecompass/privacy/, … English keeps its unprefixed URLs.
 *
 * The five page components read the locale from Astro.url, so the same markup
 * renders in all eight languages; the copy comes from src/i18n/supportCopy.ts.
 */
import CompassAboutPage from '../../../components/pages/compass/CompassAboutPage.astro';
import CompassBlogIndexPage from '../../../components/pages/compass/CompassBlogIndexPage.astro';
import CompassContactPage from '../../../components/pages/compass/CompassContactPage.astro';
import CompassPrivacyPage from '../../../components/pages/compass/CompassPrivacyPage.astro';
import CompassTermsPage from '../../../components/pages/compass/CompassTermsPage.astro';

export function getStaticPaths() {
  const locales = ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'];
  const pages = ['about', 'blog', 'contact', 'privacy', 'terms'];
  return locales.flatMap((lang) => pages.map((page) => ({ params: { lang, page } })));
}

const components = {
  about: CompassAboutPage,
  blog: CompassBlogIndexPage,
  contact: CompassContactPage,
  privacy: CompassPrivacyPage,
  terms: CompassTermsPage,
} as const;

const { page } = Astro.params as { page: keyof typeof components };
const Page = components[page];
---

<Page />
