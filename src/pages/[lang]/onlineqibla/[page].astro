---
/**
 * Localised copies of the Qibla silo pages: /es/onlineqibla/about/,
 * /ja/onlineqibla/privacy/, … English keeps its unprefixed URLs.
 *
 * The five page components read the locale from Astro.url, so the same markup
 * renders in all eight languages; the copy comes from
 * src/i18n/qiblaSupport.ts, qiblaLegal.ts and supportCopy.ts.
 */
import QiblaFinderAboutPage from '../../../components/pages/onlineqibla/QiblaFinderAboutPage.astro';
import QiblaFinderBlogIndexPage from '../../../components/pages/onlineqibla/QiblaFinderBlogIndexPage.astro';
import QiblaFinderContactPage from '../../../components/pages/onlineqibla/QiblaFinderContactPage.astro';
import QiblaFinderPrivacyPage from '../../../components/pages/onlineqibla/QiblaFinderPrivacyPage.astro';
import QiblaFinderTermsPage from '../../../components/pages/onlineqibla/QiblaFinderTermsPage.astro';

export function getStaticPaths() {
  const locales = ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'];
  const pages = ['about', 'blog', 'contact', 'privacy', 'terms'];
  return locales.flatMap((lang) => pages.map((page) => ({ params: { lang, page } })));
}

const components = {
  about: QiblaFinderAboutPage,
  blog: QiblaFinderBlogIndexPage,
  contact: QiblaFinderContactPage,
  privacy: QiblaFinderPrivacyPage,
  terms: QiblaFinderTermsPage,
} as const;

const { page } = Astro.params as { page: keyof typeof components };
const Page = components[page];
---

<Page />
