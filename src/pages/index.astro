---
import SiloLayout from '../layouts/SiloLayout.astro';
import { SITE, tools } from '../data/tools';
import { posts } from '../data/blog';

const title = 'instanten — Free Online Compass, Qibla Finder, Bubble Level & Speedometer';
const description =
  'Four free precision tools that run in your browser: find north with an online compass, get the exact qibla direction, check any surface with a bubble level, and track GPS speed. No app, no sign-up.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Free browser tools on instanten',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: new URL(`/${t.slug}/`, SITE.url).href,
      description: t.tagline,
    })),
  },
];

const latest = posts.slice(0, 4);
---

<SiloLayout title={title} description={description} path="/" schemas={schemas}>
  <!-- Hero -->
  <section class="mx-auto max-w-[80rem] px-5 pb-6 pt-14 lg:px-8 lg:pt-20">
    <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-[#E2F6D5] px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-[#163300]">
      4 tools · no install · no account
    </p>
    <h1
      class="max-w-[22ch] font-sans text-[2.6rem] font-black leading-[0.95] tracking-[-0.045em] text-ink sm:text-6xl lg:text-7xl"
    >
      Free precision tools in your browser.
    </h1>
    <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-body">
      instanten turns any phone, tablet or laptop into a compass, a qibla finder, a spirit level and
      a GPS speedometer. Sensors are read locally, so your data never leaves your device — and
      nothing needs to be installed.
    </p>
  </section>

  <!-- Tool cards -->
  <section class="mx-auto max-w-[80rem] px-5 pb-6 lg:px-8" aria-label="Tools">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <article
            class="group relative flex flex-col overflow-hidden rounded-3xl border border-hairline bg-canvas p-6 transition-shadow hover:shadow-[0_10px_40px_-18px_rgba(0,0,0,0.25)]"
            style={`--accent:${tool.accent}`}
          >
            <div
              class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl text-lg font-black"
              style={`background:${tool.accentSoft};color:${tool.accent}`}
              aria-hidden="true"
            >
              {tool.name.charAt(0)}
            </div>
            <h2 class="font-sans text-2xl font-black tracking-[-0.03em] text-ink">
              <a href={`/${tool.slug}/`} class="after:absolute after:inset-0">
                {tool.name}
              </a>
            </h2>
            <p class="mt-2 mb-6 text-sm leading-relaxed text-body">{tool.tagline}</p>

            <div class="mt-auto flex flex-wrap items-center gap-2">
              <span
                class="rounded-full px-4 py-2 text-sm font-bold text-white"
                style={`background:${tool.accent}`}
                aria-hidden="true"
              >
                Open {tool.name.split(' ').slice(-1)}
              </span>
              <span class="text-xs text-mute">Free · works offline after first load</span>
            </div>

            <ul class="relative z-10 mt-5 flex flex-wrap gap-x-3 gap-y-1 text-xs text-body">
              {['Blog', 'About', 'Privacy', 'Terms', 'Contact'].map((label) => (
                <li>
                  <a
                    href={`/${tool.slug}/${label.toLowerCase()}/`}
                    class="underline decoration-hairline underline-offset-2 hover:text-ink hover:decoration-ink"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-[80rem] px-5 py-16 lg:px-8" aria-label="How it works">
    <h2 class="mb-8 font-sans text-3xl font-black tracking-[-0.03em] text-ink">How these tools work</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="rounded-2xl bg-[#FAFAF8] p-6">
        <h3 class="mb-2 text-base font-bold text-ink">Real sensors, not guesswork</h3>
        <p class="text-sm leading-relaxed text-body">
          The compass reads your magnetometer, the level reads your accelerometer, and the
          speedometer reads GPS — all through standard browser APIs. No fake needles.
        </p>
      </div>
      <div class="rounded-2xl bg-[#FAFAF8] p-6">
        <h3 class="mb-2 text-base font-bold text-ink">Private by default</h3>
        <p class="text-sm leading-relaxed text-body">
          Sensor readings and coordinates are processed on your device. Nothing is uploaded, stored
          or profiled, and there is no account to create.
        </p>
      </div>
      <div class="rounded-2xl bg-[#FAFAF8] p-6">
        <h3 class="mb-2 text-base font-bold text-ink">Honest about limits</h3>
        <p class="text-sm leading-relaxed text-body">
          A phone is not a survey instrument. Every tool page states its real accuracy, when to
          recalibrate, and when you should use dedicated hardware instead.
        </p>
      </div>
    </div>
  </section>

  <!-- Latest guides -->
  <section class="mx-auto max-w-[80rem] px-5 pb-16 lg:px-8" aria-label="Latest guides">
    <h2 class="mb-6 font-sans text-3xl font-black tracking-[-0.03em] text-ink">Latest guides</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        latest.map((post) => (
          <li class="rounded-2xl border border-hairline p-5">
            <a
              href={`/${post.tool}/blog/${post.slug}/`}
              class="text-base font-bold tracking-tight text-ink hover:underline"
            >
              {post.title}
            </a>
            <p class="mt-1.5 text-sm leading-relaxed text-body">{post.description}</p>
            <p class="mt-2 text-xs text-mute">
              {post.minutes} min read · {post.tool.replace('-', ' ')}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</SiloLayout>
