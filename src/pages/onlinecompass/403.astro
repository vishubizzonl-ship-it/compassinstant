---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<Layout title="403 — Forbidden" description="You do not have permission to open this page." noindex>
  <Nav />
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-24 text-center">
    <p class="font-mono text-sm text-mute mb-4">403</p>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-4">Forbidden</h1>
    <p class="text-body text-base leading-relaxed mb-8">
      You do not have permission to open this page. Head back to the compass tool and continue from there.
    </p>
    <a
      href={translatePath('/onlinecompass/')}
      class="inline-flex items-center rounded-full bg-ink text-canvas px-5 py-2 text-sm font-medium hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none"
    >
      Back to compass
    </a>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-body">
      <a href={translatePath('/onlinecompass/blog/')} class="hover:text-ink transition-colors">Compass blog</a>
      <a href={translatePath('/onlinecompass/about/')} class="hover:text-ink transition-colors">About</a>
      <a href={translatePath('/onlinecompass/contact/')} class="hover:text-ink transition-colors">Contact</a>
    </div>
  </main>
  <Footer />
</Layout>
